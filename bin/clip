    echo "Usage: clip agy set profile|model|port|host|public-model|session|profiles VALUE" >&2
    exit 2
  fi

  mkdir -p "$(dirname "$CLIP_AGY_ENV")"
  touch "$CLIP_AGY_ENV"

  case "$key" in
    profile) key="CLIP_AGY_PROFILE" ;;
    model) key="CLIP_AGY_MODEL" ;;
    port) key="CLIP_AGY_PORT" ;;
    host) key="CLIP_AGY_HOST" ;;
    public-model|public_model) key="CLIP_AGY_PUBLIC_MODEL" ;;
    session) key="CLIP_AGY_SESSION" ;;
    profiles) key="CLIP_AGY_PROFILES" ;;
    *)
      echo "ERROR: unknown clip-agy setting: $key" >&2
      exit 2
      ;;
  esac

  if grep -q "^$key=" "$CLIP_AGY_ENV"; then
    python3 - "$CLIP_AGY_ENV" "$key" "$val" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
key = sys.argv[2]
val = sys.argv[3]
lines = p.read_text().splitlines()
out = []
for line in lines:
    if line.startswith(key + "="):
        out.append(f'{key}="{val}"')
    else:
        out.append(line)
p.write_text("\n".join(out) + "\n")
PY
  else
    printf '%s="%s"\n' "$key" "$val" >> "$CLIP_AGY_ENV"
  fi

  echo "set $key=$val"
}


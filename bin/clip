#!/data/data/com.termux/files/usr/bin/bash
# clip = Command Line Interface Proxy (CLI Proxy Manager)
set -euo pipefail

SESSION="clip-gw"
PROFILE_DIR="$HOME/.hermes/profiles"
CONFIG_DIR="$HOME/.config/clip"
ALIASES_FILE="$CONFIG_DIR/aliases.tsv"
AUTO_DISABLED_FILE="$CONFIG_DIR/auto.disabled"

SELF="${BASH_SOURCE[0]:-$0}"
SELF_DIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P || pwd)"
if [ -n "${CLIP_LIB_DIR:-}" ] && [ -f "$CLIP_LIB_DIR/clip_gemini.py" ]; then
  CLIP_LIB="$CLIP_LIB_DIR"
elif [ -f "$HOME/.config/clip/lib/clip_gemini.py" ]; then
  CLIP_LIB="$HOME/.config/clip/lib"
elif [ -f "$SELF_DIR/../lib/clip_gemini.py" ]; then
  CLIP_LIB="$(cd "$SELF_DIR/../lib" && pwd -P)"
else
  CLIP_LIB="$HOME/.config/clip/lib"
fi

CLIP_GEMINI_ENV="$CONFIG_DIR/clip_gemini.env"
CLIP_GEMINI_BIN="$CLIP_LIB/clip_gemini.py"
CLIP_AGY_ENV="$CONFIG_DIR/clip_agy.env"
CLIP_AGY_BIN="$CLIP_LIB/clip_agy.py"
CLIP_APPROVE_BIN="$CLIP_LIB/clip_approve.py"
CLIP_WEB_BIN="$CLIP_LIB/clip_web_fetch.py"
INTERNAL_PREFIX="clip-"

mkdir -p "$CONFIG_DIR"

usage() {
  cat <<USAGE
clip = Command Line Interface Proxy Manager

Usage:
  clip bind <profile> <alias>
  clip unbind <alias>
  clip list

  clip run <profile|alias|all>
  clip stop <profile|alias|all>
  clip restart <profile|alias|all>
  clip status
  clip web <url>
  clip approve <request|allow|deny|list|show|cleanup>
  clip auto <on|off|status|run>
  clip logs <profile|alias>
  clip view <profile|alias>

  clip gemini start
  clip gemini stop
  clip gemini restart
  clip gemini status
  clip gemini logs [N]
  clip gemini test [PROMPT]
  clip gemini config
  clip gemini set profile|model|port|host|public-model|session|profiles VALUE

  clip agy start
  clip agy stop
  clip agy restart
  clip agy status
  clip agy logs [N]
  clip agy test [PROMPT]
  clip agy config
  clip agy set profile|model|port|host|public-model|session|profiles VALUE

Examples:
  clip bind codex-tg htg
  clip bind gemini-tg htg2

  clip run htg
  clip run all
  clip logs htg
  clip stop all

  clip gemini start
  clip gemini test "Reply with only: CLIP_GEMINI_OK"
  clip gemini set model gemini-2.5-flash-lite
USAGE
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || {
    echo "ERROR: tmux not found. Install with:"
    echo "  pkg install -y tmux"
    exit 1
  }
}

is_profile() {
  [ -d "$PROFILE_DIR/$1" ]
}

is_gateway_profile() {
  local profile="$1"
  local envfile="$PROFILE_DIR/$profile/.env"
  [ -f "$envfile" ] || return 1
  grep -Eq '^[[:space:]]*TELEGRAM_BOT_TOKEN=.+' "$envfile"
}

gateway_profiles() {
  [ -d "$PROFILE_DIR" ] || return 0

  find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null |
  while IFS= read -r profile; do
    if is_gateway_profile "$profile"; then
      echo "$profile"
    fi
  done | sort
}

profile_for_alias() {
  local alias_name="$1"
  [ -f "$ALIASES_FILE" ] || return 1
  awk -F '\t' -v a="$alias_name" '$1 == a { print $2; exit }' "$ALIASES_FILE"
}

alias_for_profile() {
  local profile="$1"
  [ -f "$ALIASES_FILE" ] || return 1
  awk -F '\t' -v p="$profile" '$2 == p { print $1; exit }' "$ALIASES_FILE"
}

list_aliases_plain() {
  [ -f "$ALIASES_FILE" ] || return 0
  awk -F '\t' 'NF >= 2 { printf "  %-12s -> %s\n", $1, $2 }' "$ALIASES_FILE" | sort
}

resolve_profile() {
  local target="$1"

  if is_profile "$target"; then
    echo "$target"
    return 0
  fi

  local p
  p="$(profile_for_alias "$target" 2>/dev/null || true)"
  if [ -n "$p" ]; then
    echo "$p"
    return 0
  fi

  echo "ERROR: unknown profile or alias: $target" >&2
  echo >&2
  echo "Detected Telegram gateway profiles:" >&2
  gateway_profiles | sed 's/^/  /' >&2 || true
  echo >&2
  echo "Bound aliases:" >&2
  list_aliases_plain >&2 || true
  exit 1
}

ensure_profile_is_gateway() {
  local profile="$1"
  if ! is_gateway_profile "$profile"; then
    echo "ERROR: profile '$profile' does not look like a Telegram gateway profile."
    echo "Missing TELEGRAM_BOT_TOKEN in:"
    echo "  $PROFILE_DIR/$profile/.env"
    exit 1
  fi
}

ensure_hermes_alias() {
  local profile="$1"
  local alias_name="$2"

  if command -v "$alias_name" >/dev/null 2>&1; then
    echo "$alias_name"
    return 0
  fi

  hermes profile alias "$profile" --name "$alias_name" >/dev/null
  hash -r

  command -v "$alias_name" >/dev/null 2>&1 || {
    echo "ERROR: failed to create Hermes alias '$alias_name' for profile '$profile'."
    echo "Check that ~/.local/bin is in PATH."
    exit 1
  }

  echo "$alias_name"
}

exec_alias_for_profile_or_target() {
  local profile="$1"
  local original_target="$2"

  local bound_profile
  bound_profile="$(profile_for_alias "$original_target" 2>/dev/null || true)"
  if [ "$bound_profile" = "$profile" ]; then
    ensure_hermes_alias "$profile" "$original_target"
    return 0
  fi

  local friendly
  friendly="$(alias_for_profile "$profile" 2>/dev/null || true)"
  if [ -n "$friendly" ]; then
    ensure_hermes_alias "$profile" "$friendly"
    return 0
  fi

  local internal="${INTERNAL_PREFIX}${profile}"
  ensure_hermes_alias "$profile" "$internal"
}

# -------------------------------------------------------------------
# Gemini Bridge Management
# -------------------------------------------------------------------

load_clip_gemini_env() {
  [ -f "$CLIP_GEMINI_ENV" ] && . "$CLIP_GEMINI_ENV"

  CLIP_GEMINI_HOST="${CLIP_GEMINI_HOST:-127.0.0.1}"
  CLIP_GEMINI_PORT="${CLIP_GEMINI_PORT:-8787}"
  CLIP_GEMINI_PROFILE="${CLIP_GEMINI_PROFILE:-tg}"
  CLIP_GEMINI_MODEL="${CLIP_GEMINI_MODEL:-gemini-2.5-flash-lite}"
  CLIP_GEMINI_PUBLIC_MODEL="${CLIP_GEMINI_PUBLIC_MODEL:-clip-gemini}"
  CLIP_GEMINI_SESSION="${CLIP_GEMINI_SESSION:-clip-gemini}"
  CLIP_GEMINI_PROFILES="${CLIP_GEMINI_PROFILES:-gemini-tg}"
}

clip_gemini_url() {
  load_clip_gemini_env
  echo "http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT"
}

clip_gemini_health() {
  load_clip_gemini_env
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --max-time 3 "http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT/health" 2>/dev/null
}

clip_gemini_running() {
  load_clip_gemini_env
  tmux has-session -t "$CLIP_GEMINI_SESSION" 2>/dev/null
}

clip_gemini_status() {
  load_clip_gemini_env

  echo "== Command Line Interface Proxy - Gemini == "
  echo "session:      $CLIP_GEMINI_SESSION"
  echo "url:          http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT/v1"
  echo "profile:      $CLIP_GEMINI_PROFILE"
  echo "model:        $CLIP_GEMINI_MODEL"
  echo "public_model: $CLIP_GEMINI_PUBLIC_MODEL"
  echo "profiles:     $CLIP_GEMINI_PROFILES"
  echo "config:       $CLIP_GEMINI_ENV"

  if clip_gemini_running; then
    echo "tmux:         running"
  else
    echo "tmux:         stopped"
  fi

  local tmpbase tmp
  tmpbase="${TMPDIR:-$HOME/tmp}"
  mkdir -p "$tmpbase"
  tmp="$tmpbase/clip-gemini-health.$$"

  if clip_gemini_health > "$tmp" 2>/dev/null; then
    echo "health:       OK"
    cat "$tmp" 2>/dev/null
  else
    echo "health:       unavailable"
  fi

  rm -f "$tmp" 2>/dev/null || true
}

clip_gemini_start() {
  load_clip_gemini_env
  require_tmux

  [ -f "$CLIP_GEMINI_BIN" ] || {
    echo "ERROR: clip-gemini engine not found at:"
    echo "  $CLIP_GEMINI_BIN"
    exit 1
  }

  if clip_gemini_health >/dev/null 2>&1; then
    echo "clip-gemini already healthy: http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT/v1"
    return 0
  fi

  if clip_gemini_running; then
    echo "clip-gemini tmux session exists but health check failed: $CLIP_GEMINI_SESSION"
    echo "Try: clip gemini restart"
    return 1
  fi

  local cmd
  # Execute via python3 explicitly for consistency
  cmd=$(printf 'python3 %q serve --host %q --port %q --profile %q --model %q --public-model %q' \
    "$CLIP_GEMINI_BIN" "$CLIP_GEMINI_HOST" "$CLIP_GEMINI_PORT" "$CLIP_GEMINI_PROFILE" "$CLIP_GEMINI_MODEL" "$CLIP_GEMINI_PUBLIC_MODEL")

  tmux new-session -d -s "$CLIP_GEMINI_SESSION" "$cmd"

  echo "started clip-gemini: $CLIP_GEMINI_SESSION"
  echo "url: http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT/v1"

  sleep 1

  if clip_gemini_health >/dev/null 2>&1; then
    echo "health: OK"
  else
    echo "health: not ready yet"
  fi
}

clip_gemini_start_quiet() {
  load_clip_gemini_env
  require_tmux

  clip_gemini_health >/dev/null 2>&1 && return 0
  clip_gemini_running && return 0
  [ -f "$CLIP_GEMINI_BIN" ] || return 0

  local cmd
  cmd=$(printf 'python3 %q serve --host %q --port %q --profile %q --model %q --public-model %q' \
    "$CLIP_GEMINI_BIN" "$CLIP_GEMINI_HOST" "$CLIP_GEMINI_PORT" "$CLIP_GEMINI_PROFILE" "$CLIP_GEMINI_MODEL" "$CLIP_GEMINI_PUBLIC_MODEL")

  tmux new-session -d -s "$CLIP_GEMINI_SESSION" "$cmd" >/dev/null 2>&1 || true
}

clip_gemini_stop() {
  load_clip_gemini_env
  require_tmux

  if clip_gemini_running; then
    tmux kill-session -t "$CLIP_GEMINI_SESSION"
    echo "stopped clip-gemini: $CLIP_GEMINI_SESSION"
  else
    echo "clip-gemini already stopped"
  fi
}

clip_gemini_restart() {
  clip_gemini_stop || true
  sleep 1
  clip_gemini_start
}

clip_gemini_logs() {
  local n="${1:-80}"
  tail -n "$n" "${TMPDIR:-$HOME/tmp}/clip/clip_gemini.log" 2>/dev/null || true
}

clip_gemini_test() {
  load_clip_gemini_env
  local prompt="${1:-Reply with only: CLIP_GEMINI_OK}"

  clip_gemini_health >/dev/null 2>&1 || {
    echo "clip-gemini is not healthy. Try:"
    echo "  clip gemini start"
    exit 1
  }

  curl -s "http://$CLIP_GEMINI_HOST:$CLIP_GEMINI_PORT/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d "$(python3 - "$CLIP_GEMINI_PUBLIC_MODEL" "$prompt" <<'PY'
import json, sys
model = sys.argv[1]
prompt = sys.argv[2]
print(json.dumps({
  "model": model,
  "messages": [
    {"role": "user", "content": prompt}
  ]
}, ensure_ascii=False))
PY
)" | python3 -m json.tool
}

clip_gemini_config() {
  load_clip_gemini_env
  echo "config file: $CLIP_GEMINI_ENV"
  echo
  cat "$CLIP_GEMINI_ENV" 2>/dev/null || true
}

clip_gemini_set() {
  local key="${1:-}"
  local val="${2:-}"

  if [ -z "$key" ] || [ -z "$val" ]; then
    echo "Usage: clip gemini set profile|model|port|host|public-model|session|profiles VALUE" >&2
    exit 2
  fi

  mkdir -p "$(dirname "$CLIP_GEMINI_ENV")"
  touch "$CLIP_GEMINI_ENV"

  case "$key" in
    profile) key="CLIP_GEMINI_PROFILE" ;;
    model) key="CLIP_GEMINI_MODEL" ;;
    port) key="CLIP_GEMINI_PORT" ;;
    host) key="CLIP_GEMINI_HOST" ;;
    public-model|public_model) key="CLIP_GEMINI_PUBLIC_MODEL" ;;
    session) key="CLIP_GEMINI_SESSION" ;;
    profiles) key="CLIP_GEMINI_PROFILES" ;;
    *)
      echo "ERROR: unknown clip-gemini setting: $key" >&2
      exit 2
      ;;
  esac

  if grep -q "^$key=" "$CLIP_GEMINI_ENV"; then
    python3 - "$CLIP_GEMINI_ENV" "$key" "$val" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
key = sys.argv[2]
val = sys.argv[3]
lines = p.read_text().splitlines()
out = []
for line in lines:
    if line.startswith(key + "="):
        out.append(f'{key}="{val}"')
    else:
        out.append(line)
p.write_text("\n".join(out) + "\n")
PY
  else
    printf '%s="%s"\n' "$key" "$val" >> "$CLIP_GEMINI_ENV"
  fi

  echo "set $key=$val"
}

clip_gemini_cmd() {
  local sub="${1:-status}"
  [ "$#" -gt 0 ] && shift || true

  case "$sub" in
    start) clip_gemini_start ;;
    stop) clip_gemini_stop ;;
    restart) clip_gemini_restart ;;
    status|"") clip_gemini_status ;;
    logs|log) clip_gemini_logs "${1:-80}" ;;
    test) clip_gemini_test "${1:-Reply with only: CLIP_GEMINI_OK}" ;;
    config) clip_gemini_config ;;
    set) clip_gemini_set "$@" ;;
    *)
      cat >&2 <<USAGE
Usage:
  clip gemini start
  clip gemini stop
  clip gemini restart
  clip gemini status
  clip gemini logs [N]
  clip gemini test [PROMPT]
  clip gemini config
  clip gemini set profile|model|port|host|public-model|session|profiles VALUE
USAGE
      exit 2
      ;;
  esac
}


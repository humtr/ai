      ;;
  esac
}

profile_uses_bridge() {
  local profile="$1"
  load_clip_gemini_env

  case " $CLIP_GEMINI_PROFILES " in
    *" $profile "*) return 0 ;;
  esac

  hermes profile show "$profile" 2>/dev/null | grep -q 'google-gemini-cli'
}

profile_uses_clip_agy() {
  local profile="$1"
  load_clip_agy_env

  case " $CLIP_AGY_PROFILES " in
    *" $profile "*) return 0 ;;
  esac

  hermes profile show "$profile" 2>/dev/null | grep -qE 'agy|antigravity-cli'
}

auto_bridge_for_profile() {
  local profile="$1"

  if profile_uses_bridge "$profile"; then
    clip_gemini_start_quiet || true
  fi
  if profile_uses_clip_agy "$profile"; then
    clip_agy_start_quiet || true
  fi
}

# -------------------------------------------------------------------
# Gateway alias / run management
# -------------------------------------------------------------------

bind_alias() {
  local profile="${1:-}"
  local alias_name="${2:-}"

  [ -n "$profile" ] && [ -n "$alias_name" ] || {
    echo "Usage: clip bind <profile> <alias>"
    exit 1
  }

  is_profile "$profile" || {
    echo "ERROR: profile not found: $profile"
    exit 1
  }

  ensure_profile_is_gateway "$profile"

  echo "Binding Hermes gateway alias:"
  echo "  profile: $profile"
  echo "  alias:   $alias_name"
  echo

  ensure_hermes_alias "$profile" "$alias_name" >/dev/null

  touch "$ALIASES_FILE"

  awk -F '\t' -v a="$alias_name" -v p="$profile" '
    $1 != a && $2 != p { print }
  ' "$ALIASES_FILE" > "$ALIASES_FILE.tmp" 2>/dev/null || true

  printf "%s\t%s\n" "$alias_name" "$profile" >> "$ALIASES_FILE.tmp"
  mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"

  echo "Bound: $alias_name -> $profile"
}

unbind_alias() {
  local alias_name="${1:-}"

  [ -n "$alias_name" ] || {
    echo "Usage: clip unbind <alias>"
    exit 1
  }

  if [ -f "$ALIASES_FILE" ]; then
    awk -F '\t' -v a="$alias_name" '$1 != a { print }' "$ALIASES_FILE" > "$ALIASES_FILE.tmp" || true
    mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"
  fi

  echo "Unbound from clip: $alias_name"
  echo "Note: Hermes alias executable itself was not removed."
}

window_exists() {
  local profile="$1"
  tmux has-session -t "$SESSION" 2>/dev/null || return 1
  tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$profile"
}

run_one() {
  local target="$1"
  local profile alias_name

  profile="$(resolve_profile "$target")"
  ensure_profile_is_gateway "$profile"
  auto_bridge_for_profile "$profile"
  alias_name="$(exec_alias_for_profile_or_target "$profile" "$target")"

  if window_exists "$profile"; then
    echo "Already running or window exists: $SESSION:$profile"
    return 0
  fi

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-window -d -t "$SESSION" -n "$profile" "$alias_name gateway run"
  else
    tmux new-session -d -s "$SESSION" -n "$profile" "$alias_name gateway run"
  fi

  echo "Started: $SESSION:$profile via $alias_name"
}

stop_one() {
  local target="$1"
  local profile
  profile="$(resolve_profile "$target")"

  if window_exists "$profile"; then
    tmux kill-window -t "$SESSION:$profile" 2>/dev/null || true
    echo "Stopped: $SESSION:$profile"
  else
    echo "Not running: $SESSION:$profile"
  fi
}

restart_one() {
  local target="$1"
  stop_one "$target"
  run_one "$target"
}

logs_one() {
  local target="$1"
  local profile
  profile="$(resolve_profile "$target")"

  if ! window_exists "$profile"; then
    echo "Not running: $SESSION:$profile"
    echo "Start with: clip run $target"
    exit 1
  fi

  tmux capture-pane -t "$SESSION:$profile" -p -S -160
}

view_one() {
  local target="$1"
  local profile
  profile="$(resolve_profile "$target")"

  if ! window_exists "$profile"; then
    echo "Not running: $SESSION:$profile"
    echo "Start with: clip run $target"
    exit 1
  fi

  tmux select-window -t "$SESSION:$profile" 2>/dev/null || true
  tmux attach -t "$SESSION"
}

run_target() {
  local action="$1"
  local target="$2"

  if [ "$target" = "all" ]; then
    local found=0
    while IFS= read -r profile; do
      [ -n "$profile" ] || continue
      found=1
      "${action}_one" "$profile"
    done < <(gateway_profiles)

    if [ "$found" -eq 0 ]; then
      echo "No Telegram gateway profiles found."
      exit 1
    fi

    return 0
  fi

  "${action}_one" "$target"
}

list_all() {
  echo "== Telegram gateway profiles =="
  gateway_profiles | sed 's/^/  /' || true

  echo
  echo "== Bound aliases =="
  if [ -f "$ALIASES_FILE" ] && [ -s "$ALIASES_FILE" ]; then
    list_aliases_plain
  else
    echo "  none"
  fi

  echo
  echo "== Hermes profiles =="
  hermes profile list 2>&1 || true

  echo
  clip_gemini_status
  echo
  clip_agy_status
}

status_all() {
  echo "== tmux session =="

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux list-windows -t "$SESSION" -F '  #S:#W  pane=#{pane_current_command}'
  else
    echo "  no tmux session: $SESSION"
  fi

  echo
  echo "== Telegram gateway profiles =="
  gateway_profiles | sed 's/^/  /' || true

  echo
  echo "== Bound aliases =="
  if [ -f "$ALIASES_FILE" ] && [ -s "$ALIASES_FILE" ]; then
    list_aliases_plain
  else
    echo "  none"
  fi

  echo
  clip_gemini_status
  echo
  clip_agy_status
}

cmd="${1:-help}"
shift || true


clip_auto_cmd() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    on|enable)
      rm -f "$AUTO_DISABLED_FILE"
      echo "clip auto-start: ENABLED"
      ;;
    off|disable)
      touch "$AUTO_DISABLED_FILE"
      echo "clip auto-start: DISABLED"
      ;;
    status)
      if [ -f "$AUTO_DISABLED_FILE" ]; then
        echo "clip auto-start: DISABLED ($AUTO_DISABLED_FILE exists)"
      else
        echo "clip auto-start: ENABLED"
      fi
      ;;
    run)
      if [ -f "$AUTO_DISABLED_FILE" ]; then
        echo "clip auto-start is disabled; skipping run all"
        return 0
      fi
      require_tmux
      run_target run all
      ;;
    *)
      echo "Usage: clip auto <on|off|status|run>"
      return 1
      ;;
  esac
}

# clip web/approve early dispatch
if [ "$cmd" = "approve" ]; then
  exec python3 "$CLIP_APPROVE_BIN" "$@"
fi

if [ "$cmd" = "web" ]; then
  [ -n "${1:-}" ] || {
    echo "Usage: clip web <url>"
    exit 2
  }
  exec python3 "$CLIP_WEB_BIN" "$@"
fi

case "$cmd" in
  bind)
    bind_alias "${1:-}" "${2:-}" ;;
  unbind)
    unbind_alias "${1:-}" ;;
  list)
    list_all ;;
  run|start)
    [ -n "${1:-}" ] || { usage; exit 1; }
    require_tmux
    run_target run "$1" ;;
  stop)
    [ -n "${1:-}" ] || { usage; exit 1; }
    require_tmux
    run_target stop "$1"
    if [ "${1:-}" = "all" ]; then
      clip_gemini_stop >/dev/null 2>&1 || true
      clip_agy_stop >/dev/null 2>&1 || true
      echo "Bridge stopped: all"
    else
      target_profile="$(resolve_profile "$1" 2>/dev/null || true)"
      if [ -n "$target_profile" ]; then
        if profile_uses_bridge "$target_profile"; then
          clip_gemini_stop >/dev/null 2>&1 || true
          echo "Bridge stopped: $target_profile uses clip-gemini"
        fi
        if profile_uses_clip_agy "$target_profile"; then
          clip_agy_stop >/dev/null 2>&1 || true
          echo "clip-agy Bridge stopped: $target_profile uses clip-agy"
        fi
      fi
    fi
    ;;
  restart)
    [ -n "${1:-}" ] || { usage; exit 1; }
    require_tmux
    run_target restart "$1" ;;
  logs)
    [ -n "${1:-}" ] || { usage; exit 1; }
    require_tmux
    logs_one "$1" ;;
  view)
    [ -n "${1:-}" ] || { usage; exit 1; }
    require_tmux
    view_one "$1" ;;
  status)
    require_tmux
    status_all ;;
  auto)
    clip_auto_cmd "$@" ;;
  enable)
    clip_auto_cmd on ;;
  disable)
    clip_auto_cmd off ;;
  gemini|g)
    clip_gemini_cmd "$@" ;;
  agy|a)
    clip_agy_cmd "$@" ;;
  help|-h|--help|"")
    usage ;;
  *)
    echo "ERROR: unknown command: $cmd"
    usage
    exit 1 ;;
esac

# >>> ai provider prompt sandbox runner >>>
provider_run_manager_sandbox() {
  local kind="$1"
  local mode="$2"
  local profile="$3"
  local workdir="$4"
  shift 4

  local mgr
  mgr="$(provider_mgr "$kind")" || return $?

  case "$kind" in
    codex)
      (
        cd "$workdir" &&
        run_with_timeout env \
          CM_CWD_TTY_POLICY=sandbox \
          CM_CWD_NONTTY_POLICY=sandbox \
          "$mgr" sb "$mode" "$profile" "$@"
      )
      ;;

    gemini)
      (
        cd "$workdir" &&
        run_with_timeout env \
          GEMINI_CLI_TRUST_WORKSPACE=true \
          GM_CWD_TTY_POLICY=sandbox \
          GM_CWD_NONTTY_POLICY=sandbox \
          "$mgr" sb "$mode" "$profile" "$@"
      )
      ;;

    hermes)
      (
        cd "$workdir" &&
        run_with_timeout env \
          HM_CWD_TTY_POLICY=sandbox \
          HM_CWD_NONTTY_POLICY=sandbox \
          "$mgr" sb "$mode" "$profile" "$@"
      )
      ;;

    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}
# <<< ai provider prompt sandbox runner >>>

provider_run_manager_project() {
  local kind="$1"
  local mode="$2"
  local profile="$3"
  local workdir="$4"
  shift 4

  local mgr
  mgr="$(provider_mgr "$kind")" || return $?

  case "$kind" in
    codex)
      (
        cd "$workdir" &&
        run_with_timeout env \
          CM_CWD_TTY_POLICY=cwd \
          CM_CWD_NONTTY_POLICY=cwd \
          "$mgr" "$mode" "$profile" "$@"
      )
      ;;

    gemini)
      (
        cd "$workdir" &&
        run_with_timeout env \
          GEMINI_CLI_TRUST_WORKSPACE=true \
          GM_CWD_TTY_POLICY=cwd \
          GM_CWD_NONTTY_POLICY=cwd \
          "$mgr" "$mode" "$profile" "$@"
      )
      ;;

    hermes)
      (
        cd "$workdir" &&
        run_with_timeout env \

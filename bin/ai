      ;;
  esac
}

provider_common_context() {
  local kind="$1"
  local profile="$2"
  local workdir="$3"

  provider_prepare "$kind" || return $?

  [ -n "$profile" ] || profile="$(provider_default_profile "$kind")" || return $?
  profile_exists "$kind" "$profile" || {
    profile_hint "$kind" "$profile"
    return 127
  }

  [ -n "$workdir" ] || workdir="$(pwd -P 2>/dev/null || pwd)"
  workdir="$(resolve_workdir "$workdir")" || return $?

  AI_CONTEXT_KIND="$kind"
  AI_CONTEXT_PROFILE="$profile"
  AI_CONTEXT_WORKDIR="$workdir"
}

parse_common_options() {
  local default_provider="${1:-}"
  shift || true

  AI_COMMON_PROVIDER=""
  AI_COMMON_PROFILE=""
  AI_COMMON_WORKDIR=""
  AI_COMMON_SANDBOX="false"
  AI_COMMON_SESSION=""
  AI_COMMON_ARGS=()

  : "$default_provider"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --provider)
        [ -n "${2:-}" ] || { echo "ERROR: --provider requires a value" >&2; return 2; }
        AI_COMMON_PROVIDER="$(provider_alias_kind "$2")" || {
          echo "ERROR: unknown provider: $2" >&2
          return 2
        }
        shift 2
        ;;
      --profile|--home)
        [ -n "${2:-}" ] || { echo "ERROR: $1 requires a value" >&2; return 2; }
        AI_COMMON_PROFILE="$2"
        shift 2
        ;;
      --cwd|--cd|-C)
        [ -n "${2:-}" ] || { echo "ERROR: $1 requires a value" >&2; return 2; }
        AI_COMMON_WORKDIR="$2"
        shift 2
        ;;
      --sandbox|--sb)
        AI_COMMON_SANDBOX="true"
        shift
        ;;
      --session)
        [ -n "${2:-}" ] || { echo "ERROR: --session requires a value" >&2; return 2; }
        AI_COMMON_SESSION="$2"
        shift 2
        ;;
      --)
        shift
        AI_COMMON_ARGS=("$@")
        return 0
        ;;
      *)
        if [ -z "$AI_COMMON_PROVIDER" ] && provider_alias_kind "$1" >/dev/null 2>&1; then
          AI_COMMON_PROVIDER="$(provider_alias_kind "$1")"
          shift
        else
          AI_COMMON_ARGS=("$@")
          return 0
        fi
        ;;
    esac
  done

  return 0
}

provider_mode_parse_and_run() {
  local kind="$1"
  local mode="$2"
  shift 2

  local profile="" workdir="" use_sandbox="false" prompt

  [ "$#" -gt 0 ] || {
    echo "Usage: ai $mode $kind [--profile NAME] [--cwd DIR|--sandbox] PROMPT" >&2
    return 2
  }

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --profile|--home)
        [ -n "${2:-}" ] || { echo "ERROR: $1 requires a value" >&2; return 2; }
        profile="$2"
        shift 2
        ;;
      --cwd|--cd|-C)
        [ -n "${2:-}" ] || { echo "ERROR: $1 requires a value" >&2; return 2; }
        workdir="$2"
        shift 2
        ;;
      --sandbox|--sb)
        use_sandbox="true"
        shift
        ;;
      --)
        break
        ;;
      -*)
        echo "ERROR: unknown ai common option for $mode: $1" >&2
        echo "Use -- before native provider flags." >&2
        return 2
        ;;
      *)
        if [ -z "$profile" ] && profile_exists "$kind" "$1"; then
          profile="$1"
          shift
        else
          break
        fi
        ;;
    esac
  done

  provider_common_context "$kind" "$profile" "${workdir:-}" || return $?
  profile="$AI_CONTEXT_PROFILE"
  workdir="$AI_CONTEXT_WORKDIR"

  if [ "$use_sandbox" = "true" ]; then
    workdir="$(ai_workdir "$kind" "$profile")"
    mkdir -p "$workdir"
    workdir="$(resolve_workdir "$workdir")" || return $?
  fi

  [ "$#" -gt 0 ] || {
    echo "Usage: ai $mode $kind [--profile NAME] [--cwd DIR|--sandbox] PROMPT" >&2
    return 2
  }

  if [ "${1:-}" = "-" ] || [ "${1:-}" = "--" ]; then
    provider_run_manager_project "$kind" "$mode" "$profile" "$workdir" "$@"
    return $?
  fi

  prompt="$(join_prompt "$@")"
  provider_run_manager_project "$kind" "$mode" "$profile" "$workdir" "$prompt"
}

provider_mode_cmd() {
  local kind="$1"
  local mode="$2"
  shift 2

  provider_mode_parse_and_run "$kind" "$mode" "$@"
}


# Provider alias normalization.
# Keep this as the only place that maps public provider aliases to canonical kinds.
provider_alias_kind() {
  case "${1:-}" in
    codex|cm|c) echo "codex" ;;
    gemini|gm|g) echo "gemini" ;;
    hermes|hm|h) echo "hermes" ;;
    *)
      return 1
      ;;
  esac
}

provider_mode_dispatch() {
  local mode="$1"
  local provider="$2"
  shift 2

  local kind
  kind="$(provider_alias_kind "$provider")" || {
    echo "ERROR: unknown provider: $provider" >&2
    return 2
  }

  case "$mode" in
    task|chat|plan)
      provider_mode_cmd "$kind" "$mode" "$@"
      ;;
    *)
      echo "ERROR: unknown provider mode: $mode" >&2
      return 2
      ;;
  esac
}

task_provider() {
  local provider="$1"
  shift
  provider_mode_dispatch task "$provider" "$@"
}

chat_provider() {
  local provider="$1"
  shift
  provider_mode_dispatch chat "$provider" "$@"
}

plan_provider() {
  local provider="$1"
  shift
  provider_mode_dispatch plan "$provider" "$@"
}

default_mode() {
  local mode="$1"
  shift

  if [ "${AI_FALLBACK_ENABLED:-true}" != "true" ]; then
    provider_mode_dispatch "$mode" "$AI_DEFAULT_PROVIDER" "$@"
    return $?
  fi

  local provider rc last_rc=1

  for provider in $(provider_order); do
    echo "[ai] trying provider: $provider ($mode)" >&2
    provider_mode_dispatch "$mode" "$provider" "$@"
    rc=$?

    if [ "$rc" -eq 0 ]; then
      return 0
    fi

    last_rc="$rc"

    case "$provider" in
      codex|cm|c) failure_hint codex "$AI_CODEX_PROFILE" "$rc" ;;
      gemini|gm|g) failure_hint gemini "$AI_GEMINI_PROFILE" "$rc" ;;
      hermes|hm|h) failure_hint hermes "$AI_HERMES_PROFILE" "$rc" ;;
    esac

    echo "[ai] fallback: next provider" >&2
    echo >&2
  done

  echo "[ai] all fallback providers failed" >&2
  return "$last_rc"
}

task_default()  { default_mode task "$@"; }
chat_default() { default_mode chat "$@"; }
plan_default() { default_mode plan "$@"; }

mode_cmd() {
  local mode="$1"
  shift

  [ "$#" -gt 0 ] || {
    echo "Usage: ai $mode [codex|gemini|hermes] [--profile NAME] [--cwd DIR|--sandbox] PROMPT" >&2
    return 2
  }

  local provider=""

  if [ "${1:-}" = "--provider" ]; then
    [ -n "${2:-}" ] || { echo "ERROR: --provider requires a value" >&2; return 2; }
    provider="$2"
    shift 2
  elif provider_alias_kind "${1:-}" >/dev/null 2>&1; then
    provider="$1"
    shift
  fi

  if [ -n "$provider" ]; then
    provider_mode_dispatch "$mode" "$provider" "$@"
  else
    default_mode "$mode" "$@"
  fi
}

task_cmd() { mode_cmd task "$@"; }
chat_cmd() { mode_cmd chat "$@"; }
plan_cmd() { mode_cmd plan "$@"; }

provider_native_subcommands() {
  case "${1:-}" in
    codex)
      echo "profile run ask task chat plan exec raw status doctor update help -h --help sb sandbox here"
      ;;

    gemini)
      echo "profile run ask task chat plan raw status doctor backup update logs lag help -h --help sb sandbox here"
      ;;

    hermes)
      echo "profile run ask task chat plan raw gateway gw status doctor backup update logs help -h --help sb sandbox here"
      ;;

    *)
      return 1
      ;;
  esac
}

provider_is_native_subcommand() {
  local kind="${1:-}"
  local sub="${2:-}"
  local allowed

  [ -n "$kind" ] && [ -n "$sub" ] || return 1

  allowed="$(provider_native_subcommands "$kind")" || return 1

  case " $allowed " in
    *" $sub "*) return 0 ;;
    *) return 1 ;;
  esac
}

# >>> ai sandbox native subcommand metadata >>>
provider_sandbox_native_subcommands() {
  case "${1:-}" in
    codex)
      echo "run raw exec"
      ;;

    gemini)
      echo "run raw"
      ;;

    hermes)
      echo "run raw"
      ;;

    *)
      return 1
      ;;
  esac
}

provider_is_sandbox_native_subcommand() {
  local kind="${1:-}"
  local sub="${2:-}"
  local allowed

  [ -n "$kind" ] && [ -n "$sub" ] || return 1

  allowed="$(provider_sandbox_native_subcommands "$kind")" || return 1

  case " $allowed " in
    *" $sub "*) return 0 ;;
    *) return 1 ;;
  esac
}
# <<< ai sandbox native subcommand metadata >>>

# >>> ai provider native passthrough >>>
provider_native_passthrough() {
  local kind="$1"
  local mgr="$2"
  local default_profile="$3"
  local sub="$4"
  shift 4 || true

  local profile="$default_profile"
  local workdir

  case "$sub" in
    run|raw|exec)
      # Optional explicit profile:
      #   ai codex run lab
      #   ai gemini raw tg -- --version
      #
      # Critical: check $# before touching $1.
      if [ "$#" -gt 0 ] && profile_exists "$kind" "$1"; then
        profile="$1"
        shift
      fi

      profile_exists "$kind" "$profile" || {
        profile_hint "$kind" "$profile"
        return 127
      }

      workdir="$(ai_workdir "$kind" "$profile")"
      mkdir -p "$workdir"
      cd "$workdir" || return 1

      if provider_is_sandbox_native_subcommand "$kind" "$sub"; then
        provider_exec_sandbox "$kind" "$mgr" "$sub" "$profile" "$@"
      else
        exec "$mgr" "$sub" "$profile" "$@"
      fi
      ;;

    *)
      # status/help/profile/list/update/logs/etc. stay plain native passthrough.
      exec "$mgr" "$sub" "$@"
      ;;
  esac
}
# <<< ai provider native passthrough >>>

provider_native_project() {
  local kind="$1"
  local profile="$2"
  local workdir="$3"
  shift 3

  case "$kind" in
    codex)
      (
        cd "$workdir" &&
        CODEX_HOME="$(provider_profile_home codex "$profile")" \
          codex -C "$workdir" "$@"
      )
      ;;
    gemini)
      (
        cd "$workdir" &&
        provider_project_env gemini gm raw "$profile" -- "$@"
      )
      ;;
    hermes)
      (
        cd "$workdir" &&
        provider_project_env hermes hm raw "$profile" -- "$@"
      )
      ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

provider_list_sessions() {
  local kind="$1"
  local profile="$2"
  local workdir="$3"

  case "$kind" in
    codex)
      local home sessions
      home="$(provider_profile_home codex "$profile")"
      sessions="$home/sessions"
      echo "== Codex sessions =="
      echo "Profile: $profile"
      echo "CWD:     $workdir"
      echo "Home:    $home"
      echo
      if [ ! -d "$sessions" ]; then
        echo "No sessions directory: $sessions"
        return 0
      fi
      find "$sessions" -type f -name '*.jsonl' -printf '%T@ %TY-%Tm-%Td %TH:%TM %p\n' 2>/dev/null |
        sort -nr |
        sed -E 's/^[0-9.]+ //; s#^.*/rollout-[0-9TZ:-]+-##; s#\.jsonl$##' |
        sed -n '1,40p'
      ;;
    gemini)
      provider_native_project gemini "$profile" "$workdir" --list-sessions
      ;;
    hermes)
      provider_native_project hermes "$profile" "$workdir" sessions list --limit 40
      ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

provider_resume_session() {
  local kind="$1"
  local profile="$2"
  local workdir="$3"
  local session="$4"
  shift 4

  case "$kind" in
    codex)
      if [ -z "$session" ] && [ -t 0 ] && [ -t 1 ]; then
        provider_native_project codex "$profile" "$workdir" resume "$@"
      elif [ -z "$session" ] || [ "$session" = "latest" ] || [ "$session" = "last" ]; then
        provider_native_project codex "$profile" "$workdir" resume --last "$@"
      else
        provider_native_project codex "$profile" "$workdir" resume "$session" "$@"
      fi
      ;;
    gemini)
      [ -n "$session" ] || session="latest"
      provider_native_project gemini "$profile" "$workdir" --resume "$session" "$@"
      ;;
    hermes)
      if [ -z "$session" ] || [ "$session" = "latest" ] || [ "$session" = "last" ]; then
        provider_native_project hermes "$profile" "$workdir" --continue "$@"
      else
        provider_native_project hermes "$profile" "$workdir" --resume "$session" "$@"
      fi
      ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

provider_browse_sessions() {
  local kind="$1"
  local profile="$2"
  local workdir="$3"

  case "$kind" in
    codex)
      provider_native_project codex "$profile" "$workdir" resume
      ;;
    gemini)
      echo "Gemini has no native interactive session picker in this wrapper." >&2
      echo "Use: ai list gemini --cwd DIR" >&2
      echo "Then: ai resume gemini --cwd DIR <index|latest>" >&2
      return 2
      ;;
    hermes)
      provider_native_project hermes "$profile" "$workdir" sessions browse
      ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

common_provider_cmd() {
  local action="$1"
  shift

  parse_common_options "$AI_DEFAULT_PROVIDER" "$@" || return $?

  local kind profile workdir session
  kind="${AI_COMMON_PROVIDER:-}"
  [ -n "$kind" ] || kind="$(provider_alias_kind "$AI_DEFAULT_PROVIDER")" || return $?

  profile="$AI_COMMON_PROFILE"
  workdir="$AI_COMMON_WORKDIR"

  provider_common_context "$kind" "$profile" "${workdir:-}" || return $?
  profile="$AI_CONTEXT_PROFILE"
  workdir="$AI_CONTEXT_WORKDIR"

  if [ "$AI_COMMON_SANDBOX" = "true" ]; then
    workdir="$(ai_workdir "$kind" "$profile")"
    mkdir -p "$workdir"
    workdir="$(resolve_workdir "$workdir")" || return $?
  fi

  case "$action" in
    run)
      provider_native_project "$kind" "$profile" "$workdir" "${AI_COMMON_ARGS[@]}"
      ;;
    list)
      provider_list_sessions "$kind" "$profile" "$workdir"
      ;;
    resume)
      session="$AI_COMMON_SESSION"
      if [ -z "$session" ] && [ "${#AI_COMMON_ARGS[@]}" -gt 0 ]; then
        session="${AI_COMMON_ARGS[0]}"
        AI_COMMON_ARGS=("${AI_COMMON_ARGS[@]:1}")
      fi
      provider_resume_session "$kind" "$profile" "$workdir" "$session" "${AI_COMMON_ARGS[@]}"
      ;;
    browse|select)
      provider_browse_sessions "$kind" "$profile" "$workdir"
      ;;
    *)
      echo "ERROR: unknown common action: $action" >&2
      return 2
      ;;
  esac
}

provider_or_router() {
  local provider="$1"
  shift

  local kind mgr first mode rc default_profile

  kind="$(provider_alias_kind "$provider")" || {
    echo "ERROR: unknown provider: $provider" >&2
    return 2
  }

  mgr="$(provider_mgr "$kind")" || return $?
  default_profile="$(provider_default_profile "$kind")" || return $?

  provider_prepare "$kind" || return $?

  [ "$#" -gt 0 ] || exec "$mgr"

  first="${1:-}"
  mode=""

  # Provider-first normalized forms.
  # These MUST run before native manager passthrough.
  case "$first" in
    run)
      shift
      common_provider_cmd run --provider "$kind" "$@"
      rc=$?
      ;;
    list|sessions)
      shift
      common_provider_cmd list --provider "$kind" "$@"
      rc=$?
      ;;
    resume)
      shift
      common_provider_cmd resume --provider "$kind" "$@"
      rc=$?
      ;;
    browse|select)
      shift
      common_provider_cmd browse --provider "$kind" "$@"
      rc=$?
      ;;
    ask|chat)
      mode="chat"
      shift
      provider_mode_dispatch "$mode" "$kind" "$@"
      rc=$?
      ;;
    task)
      mode="task"
      shift
      provider_mode_dispatch "$mode" "$kind" "$@"
      rc=$?
      ;;
    plan)
      mode="plan"
      shift
      provider_mode_dispatch "$mode" "$kind" "$@"
      rc=$?
      ;;
    *)
      if provider_is_native_subcommand "$kind" "$first"; then
        provider_native_passthrough "$kind" "$mgr" "$default_profile" "$@"
        return $?
      fi

      # Historical provider shortcut:
      #   ai gemini PROMPT -> ai task gemini PROMPT
      mode="task"
      provider_mode_dispatch "$mode" "$kind" "$@"
      rc=$?
      ;;
  esac

  if [ "$rc" -ne 0 ] && [ -n "$mode" ] && [ "${AI_EXPLICIT_FALLBACK:-false}" = "true" ]; then
    echo "[ai] explicit provider failed; fallback enabled" >&2
    default_mode "$mode" "$@"
    return $?
  fi

  return "$rc"
}

config_cmd() {
  local sub="${1:-show}"
  [ "$#" -gt 0 ] && shift || true

  mkdir -p "$CONFIG_DIR"
  touch "$CONFIG_FILE"

  case "$sub" in
    show|"")
      echo "config: $CONFIG_FILE"
      echo
      cat "$CONFIG_FILE"
      ;;
    path)
      echo "$CONFIG_FILE"
      ;;
    edit)
      "${EDITOR:-nano}" "$CONFIG_FILE"
      ;;
    set)
      local key="${1:-}"
      local val="${2:-}"

      [ -n "$key" ] && [ -n "$val" ] || {
        echo "Usage: ai config set KEY VALUE" >&2
        return 2
      }

      case "$key" in
        default-provider) key="AI_DEFAULT_PROVIDER" ;;
        codex-profile) key="AI_CODEX_PROFILE" ;;
        gemini-profile) key="AI_GEMINI_PROFILE" ;;
        hermes-profile) key="AI_HERMES_PROFILE" ;;
        fallback-enabled) key="AI_FALLBACK_ENABLED" ;;
        fallback-providers) key="AI_FALLBACK_PROVIDERS" ;;
        explicit-fallback) key="AI_EXPLICIT_FALLBACK" ;;
        ask-timeout) key="AI_ASK_TIMEOUT" ;;
        auto-start-bridge) key="AI_AUTO_START_BRIDGE" ;;
      esac

      case "$key" in
        AI_DEFAULT_PROVIDER|AI_CODEX_PROFILE|AI_GEMINI_PROFILE|AI_HERMES_PROFILE|AI_FALLBACK_ENABLED|AI_FALLBACK_PROVIDERS|AI_EXPLICIT_FALLBACK|AI_ASK_TIMEOUT|AI_AUTO_START_BRIDGE) ;;
        *)
          echo "ERROR: unknown config key: $key" >&2
          return 2
          ;;
      esac

      python - "$CONFIG_FILE" "$key" "$val" <<'PY'
from pathlib import Path
import sys

p = Path(sys.argv[1])
key = sys.argv[2]
val = sys.argv[3]

lines = p.read_text().splitlines() if p.exists() else []
out = []
done = False

for line in lines:
    if line.startswith(key + "="):
        out.append(f'{key}="{val}"')
        done = True
    else:
        out.append(line)

if not done:
    out.append(f'{key}="{val}"')

p.write_text("\n".join(out) + "\n")
PY
      echo "set $key=$val"
      ;;
    *)
      echo "Usage: ai config [show|path|edit|set KEY VALUE]" >&2
      return 2
      ;;
  esac
}

up_cmd() {
  need hgw || return $?
  hgw bridge start || true
  hgw run all
  echo
  hgw status || true
  echo
  hgw bridge status || true
}

down_cmd() {
  need hgw || return $?
  hgw-auto off >/dev/null 2>&1 || true
  hgw stop all || true
  hgw bridge stop || true
}

restart_cmd() {
  down_cmd || true
  up_cmd
}

plane_cmd() {
  local sub="${1:-status}"
  [ "$#" -gt 0 ] && shift || true

  need hgw || return $?

  case "$sub" in
    status|"")
      hgw status || true
      echo
      hgw bridge status || true
      ;;
    view)
      [ -n "${1:-}" ] || { echo "Usage: ai plane view <profile>" >&2; return 2; }
      exec hgw view "$1"
      ;;
    logs)
      if [ "${1:-}" = "bridge" ] || [ "${1:-}" = "hgb" ]; then
        hgw bridge logs "${2:-120}"
      else
        [ -n "${1:-}" ] || { echo "Usage: ai plane logs <profile|bridge>" >&2; return 2; }
        hgw logs "$1"
      fi
      ;;
    *)
      echo "Usage: ai plane [status|view|logs]" >&2
      return 2
      ;;
  esac
}

logs_cmd() {
  need hgw || return $?
  local target="${1:-bridge}"

  if [ "$target" = "bridge" ] || [ "$target" = "hgb" ]; then
    hgw bridge logs "${2:-120}"
  else
    hgw logs "$target"
  fi
}

auto_cmd() {
  local sub="${1:-status}"
  shift 2>/dev/null || true

  command -v hgw-auto >/dev/null 2>&1 || {
    echo "ERROR: hgw-auto not found" >&2
    return 127
  }

  case "$sub" in
    on|enable)
      hgw-auto on
      ;;
    off|disable)
      hgw-auto off
      ;;
    run|start)
      hgw-auto run
      ;;
    status|"")
      hgw-auto status
      ;;
    logs|log)
      hgw-auto logs "${1:-80}"
      ;;
    *)
      echo "Usage: ai auto [on|off|status|run|logs]" >&2
      return 2
      ;;
  esac
}

status_cmd() {
  echo "== ai config =="
  echo "AI_DEFAULT_PROVIDER=$AI_DEFAULT_PROVIDER"
  echo "AI_CODEX_PROFILE=$AI_CODEX_PROFILE"
  echo "AI_GEMINI_PROFILE=$AI_GEMINI_PROFILE"
  echo "AI_HERMES_PROFILE=$AI_HERMES_PROFILE"
  echo "AI_FALLBACK_ENABLED=$AI_FALLBACK_ENABLED"
  echo "AI_FALLBACK_PROVIDERS=$AI_FALLBACK_PROVIDERS"
  echo "AI_EXPLICIT_FALLBACK=$AI_EXPLICIT_FALLBACK"
  echo "AI_ASK_TIMEOUT=$AI_ASK_TIMEOUT"
  echo "AI_AUTO_START_BRIDGE=$AI_AUTO_START_BRIDGE"

  echo
  echo "== commands =="
  for c in cm gm hm hgw hgb; do
    printf "%-4s " "$c"
    command -v "$c" 2>/dev/null || echo "missing"
  done

  echo
  echo "== hgw/hgb =="
  hgw status 2>/dev/null || true
  echo
  hgw bridge status 2>/dev/null || true
}

check_cmd() {
  echo "== syntax/path check =="
  for c in cm gm hm hgw hgb; do
    printf "%-4s " "$c"
    command -v "$c" 2>/dev/null || { echo "missing"; continue; }
    p="$(command -v "$c")"
    if head -n 1 "$p" | grep -q 'python'; then
      python -m py_compile "$p" >/dev/null && echo "OK"
    else
      bash -n "$p" >/dev/null && echo "OK"
    fi
  done

  echo
  echo "== default profiles =="
  for item in "codex:$AI_CODEX_PROFILE" "gemini:$AI_GEMINI_PROFILE" "hermes:$AI_HERMES_PROFILE"; do
    kind="${item%%:*}"
    profile="${item#*:}"
    printf "%-8s %-12s " "$kind" "$profile"
    if profile_exists "$kind" "$profile"; then echo "OK"; else echo "missing"; fi
  done

  echo
  echo "== bridge =="
  hgw bridge status 2>/dev/null || true
}

load_config

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  cm|c) need cm && exec cm "$@" ;;
  gm|g) need gm && exec gm "$@" ;;
  hm|h) need hm && exec hm "$@" ;;

  codex) provider_or_router codex "$@" ;;
  gemini) provider_or_router gemini "$@" ;;
  hermes) provider_or_router hermes "$@" ;;

  hgw|gateway|gw) need hgw && exec hgw "$@" ;;
  hgb) need hgb && exec hgb "$@" ;;
  bridge|br) need hgw && exec hgw bridge "$@" ;;

  ask|chat) chat_cmd "$@" ;;
  task) task_cmd "$@" ;;
  plan) plan_cmd "$@" ;;
  run) common_provider_cmd run "$@" ;;
  list|sessions) common_provider_cmd list "$@" ;;
  resume) common_provider_cmd resume "$@" ;;
  browse|select) common_provider_cmd browse "$@" ;;

  up|start) up_cmd ;;
  down|stop) down_cmd ;;
  auto) auto_cmd "$@" ;;
  restart) restart_cmd ;;
  plane|planes) plane_cmd "$@" ;;
  logs|log) logs_cmd "$@" ;;

  config|cfg) config_cmd "$@" ;;
  status) status_cmd ;;
  check|doctor) check_cmd ;;
  help|-h|--help|"") usage ;;

  *) chat_default "$cmd" "$@" ;;
esac

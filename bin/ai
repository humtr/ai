#!/data/data/com.termux/files/usr/bin/bash
# ai = AI Manager
set -euo pipefail

CONFIG_DIR="$HOME/.config/ai"
CONFIG_FILE="$CONFIG_DIR/config.env"

AI_DEFAULT_PROVIDER="hermes"
AI_CODEX_PROFILE="main"
AI_GEMINI_PROFILE="main"
AI_HERMES_PROFILE="main"
AI_FALLBACK_ENABLED="true"
AI_FALLBACK_PROVIDERS="hermes gemini codex"
AI_EXPLICIT_FALLBACK="false"
AI_ASK_TIMEOUT="180"
AI_AUTO_START_BRIDGE="false"

load_config() {
  mkdir -p "$CONFIG_DIR"
  [ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

  AI_DEFAULT_PROVIDER="${AI_DEFAULT_PROVIDER:-hermes}"
  AI_CODEX_PROFILE="${AI_CODEX_PROFILE:-main}"
  AI_GEMINI_PROFILE="${AI_GEMINI_PROFILE:-main}"
  AI_HERMES_PROFILE="${AI_HERMES_PROFILE:-main}"
  AI_FALLBACK_ENABLED="${AI_FALLBACK_ENABLED:-true}"
  AI_FALLBACK_PROVIDERS="${AI_FALLBACK_PROVIDERS:-hermes gemini codex}"
  AI_EXPLICIT_FALLBACK="${AI_EXPLICIT_FALLBACK:-false}"
  AI_ASK_TIMEOUT="${AI_ASK_TIMEOUT:-180}"
  AI_AUTO_START_BRIDGE="${AI_AUTO_START_BRIDGE:-false}"
}

usage() {
  cat <<USAGE
ai = AI Manager

Core modes:
  ai ask [provider] [options] "prompt"  -> no-tool chat
  ai chat [provider] [options] "prompt" -> same as ask
  ai task [provider] [options] "prompt" -> tool-capable task
  ai plan [provider] [options] "prompt" -> plan-only prompt

Common command model:
  ai run [provider] [options] [-- native args...]
  ai list [provider] [options]
  ai resume [provider] [options] [session|latest] [prompt/native args...]
  ai browse [provider] [options]

Common options:
  --provider codex|gemini|hermes
  --profile NAME                     -> provider home/profile override
  --home NAME                        -> alias for --profile
  --cwd DIR, --cd DIR, -C DIR         -> project working directory
  --sandbox, --sb                    -> use ~/sb/<provider>/<profile>

Accounts:
  Account selection is profile/home-bound. Use --profile/--home to select the
  provider home that carries the desired credentials. If a provider exposes a
  narrower account switch, pass it after -- to the native provider command.

Provider-first forms:
  ai codex ask [options] "prompt"    -> cm chat \$AI_CODEX_PROFILE
  ai gemini ask [options] "prompt"   -> gm chat \$AI_GEMINI_PROFILE
  ai hermes ask [options] "prompt"   -> hm chat \$AI_HERMES_PROFILE

  ai codex task [options] "prompt"   -> cm task \$AI_CODEX_PROFILE
  ai gemini task [options] "prompt"  -> gm task \$AI_GEMINI_PROFILE
  ai hermes task [options] "prompt"  -> hm task \$AI_HERMES_PROFILE

  ai codex plan [options] "prompt"   -> cm plan \$AI_CODEX_PROFILE
  ai gemini plan [options] "prompt"  -> gm plan \$AI_GEMINI_PROFILE
  ai hermes plan [options] "prompt"  -> hm plan \$AI_HERMES_PROFILE

Canonical provider forms:
  ai ask codex [options] "prompt"    -> cm chat \$AI_CODEX_PROFILE
  ai ask gemini [options] "prompt"   -> gm chat \$AI_GEMINI_PROFILE
  ai ask hermes [options] "prompt"   -> hm chat \$AI_HERMES_PROFILE

  ai task codex [options] "prompt"   -> cm task \$AI_CODEX_PROFILE
  ai task gemini [options] "prompt"  -> gm task \$AI_GEMINI_PROFILE
  ai task hermes [options] "prompt"  -> hm task \$AI_HERMES_PROFILE

  ai plan codex [options] "prompt"   -> cm plan \$AI_CODEX_PROFILE
  ai plan gemini [options] "prompt"  -> gm plan \$AI_GEMINI_PROFILE
  ai plan hermes [options] "prompt"  -> hm plan \$AI_HERMES_PROFILE

Provider task shortcuts:
  ai codex "prompt"                  -> ai task codex "prompt"
  ai gemini "prompt"                 -> ai task gemini "prompt"
  ai hermes "prompt"                 -> ai task hermes "prompt"

Provider-native passthroughs:
  ai run codex [options] [-- args...] -> codex in the selected cwd/profile
  ai run gemini [options] [-- args...] -> gemini in the selected cwd/profile
  ai run hermes [options] [-- args...] -> hermes in the selected cwd/profile

  ai codex raw [profile] -- <args...> -> legacy sandbox + cm raw passthrough
  ai gemini raw [profile] -- <args...>-> legacy sandbox + gm raw passthrough
  ai hermes raw [profile] -- <args...>-> legacy sandbox + hm raw passthrough

  ai codex exec [profile] <args...>   -> legacy sandbox + native codex exec passthrough

Manager routers:
  ai cm <args...>                     -> cm <args...>
  ai gm <args...>                     -> gm <args...>
  ai hm <args...>                     -> hm <args...>
  ai hgw <args...>                    -> hgw <args...>
  ai hgb <args...>                    -> hgb <args...>

Plane / service control:
  ai up                               -> hgw bridge start + hgw run all
  ai down                             -> hgw stop all + hgw bridge stop
  ai restart                          -> ai down + ai up
  ai plane status                     -> hgw status + hgw bridge status
  ai auto [on|off|status|run]          -> control hgw-auto
  ai plane view <profile>             -> hgw view <profile>
  ai logs <profile|bridge>            -> hgw logs / hgw bridge logs

Config:
  ai config
  ai config set default-provider hermes
  ai config set codex-profile main
  ai config set gemini-profile tg
  ai config set hermes-profile main
  ai config set ask-timeout 180

Current:
  AI_DEFAULT_PROVIDER="$AI_DEFAULT_PROVIDER"
  AI_CODEX_PROFILE="$AI_CODEX_PROFILE"
  AI_GEMINI_PROFILE="$AI_GEMINI_PROFILE"
  AI_HERMES_PROFILE="$AI_HERMES_PROFILE"
  AI_FALLBACK_ENABLED="$AI_FALLBACK_ENABLED"
  AI_FALLBACK_PROVIDERS="$AI_FALLBACK_PROVIDERS"
  AI_EXPLICIT_FALLBACK="$AI_EXPLICIT_FALLBACK"
  AI_ASK_TIMEOUT="$AI_ASK_TIMEOUT"
  AI_AUTO_START_BRIDGE="$AI_AUTO_START_BRIDGE"

Notes:
  ask/chat = no-tool answer mode.
  task     = tool-capable work mode.
  plan     = plan-only mode; should not perform writes or destructive work.
  Common run/task/list/resume commands use the current directory by default.
  Add --cwd DIR for another project or --sandbox for the provider sandbox.
  Use quotes for JSON, code, shell symbols, $, *, >, |, ;, &, parentheses,
  command substitutions, backticks, braces, brackets, newlines, and leading dashes.
USAGE
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "ERROR: missing command: $1" >&2
    hint_missing_command "$1" >&2
    return 127
  }
}

hint_missing_command() {
  case "$1" in
    cm)  echo "Hint: install/restore ~/bin/cm = Codex Manager" ;;
    gm)  echo "Hint: install/restore ~/bin/gm = Gemini Manager" ;;
    hm)  echo "Hint: install/restore ~/bin/hm = Hermes Manager" ;;
    hgw) echo "Hint: install/restore ~/bin/hgw = Hermes Gateway Manager" ;;
    hgb) echo "Hint: install/restore ~/bin/hgb = Hermes Gemini Bridge" ;;
  esac
}

profile_exists() {
  local kind="$1"
  local profile="$2"

  case "$kind" in
    codex)  [ -d "$HOME/.codex-homes/$profile" ] ;;
    gemini) [ -d "$HOME/.gemini-homes/$profile" ] ;;
    hermes) [ -d "$HOME/.hermes/profiles/$profile" ] ;;
    *) return 1 ;;
  esac
}

profile_hint() {
  local kind="$1"
  local profile="$2"

  case "$kind" in
    codex)
      echo "[ai] Codex profile not found or not ready: $profile" >&2
      echo "     Try: cm profile list" >&2
      echo "     Try: cm profile add $profile" >&2
      echo "     Try: cm run $profile" >&2
      ;;
    gemini)
      echo "[ai] Gemini profile not found or not ready: $profile" >&2
      echo "     Try: gm profile list" >&2
      echo "     Try: gm profile add $profile" >&2
      echo "     Try: cd ~/sb/gemini/$profile && gm run $profile" >&2
      ;;
    hermes)
      echo "[ai] Hermes profile not found or not ready: $profile" >&2
      echo "     Try: hm profile list" >&2
      echo "     Try: hm profile use $profile" >&2
      echo "     Try: hermes model  # or hermes setup/auth" >&2
      ;;
  esac
}

failure_hint() {
  local kind="$1"
  local profile="$2"
  local rc="$3"

  echo "[ai] $kind/$profile failed with exit=$rc" >&2

  case "$kind" in
    codex)
      echo "     Check: cd ~/sb/codex/$profile && cm task $profile \"Reply with only: OK\"" >&2
      ;;
    gemini)
      echo "     Check: cd ~/sb/gemini/$profile && gm task $profile -- --skip-trust -p 'Reply with only: OK'" >&2
      echo "     If trust error appears, run from ~/sb/gemini/$profile or re-run gm run $profile." >&2
      ;;
    hermes)
      echo "     Check: cd ~/sb/hermes/$profile && hm task $profile \"Reply with only: OK\"" >&2
      echo "     If provider error appears, run: hm profile use $profile && hermes model" >&2
      echo "     If custom hgb is used, check: ai bridge status" >&2
      ;;
  esac
}

join_prompt() {
  local IFS=" "
  printf "%s" "$*"
}

ai_workdir() {
  local kind="$1"
  local profile="$2"

  case "$kind" in
    codex)  echo "$HOME/sb/codex/$profile" ;;
    gemini) echo "$HOME/sb/gemini/$profile" ;;
    hermes) echo "$HOME/sb/hermes/$profile" ;;
    *) echo "$HOME" ;;
  esac
}

expand_path_arg() {
  local path="$1"

  case "$path" in
    "~")
      echo "$HOME"
      ;;
    "~/"*)
      echo "$HOME/${path#"~/"}"
      ;;
    /*)
      echo "$path"
      ;;
    *)
      echo "$(pwd -P 2>/dev/null || pwd)/$path"
      ;;
  esac
}

resolve_workdir() {
  local input="$1"
  local expanded

  expanded="$(expand_path_arg "$input")"
  [ -d "$expanded" ] || {
    echo "ERROR: cwd does not exist: $input" >&2
    return 2
  }

  (cd "$expanded" && pwd -P)
}

provider_profile_home() {
  local kind="$1"
  local profile="$2"

  case "$kind" in
    codex) echo "$HOME/.codex-homes/$profile" ;;
    gemini) echo "$HOME/.gemini-homes/$profile" ;;
    hermes) echo "$HOME/.hermes/profiles/$profile" ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

provider_project_env() {
  local kind="$1"
  shift

  case "$kind" in
    codex)
      env \
        CM_CWD_TTY_POLICY=cwd \
        CM_CWD_NONTTY_POLICY=cwd \
        "$@"
      ;;
    gemini)
      env \
        GEMINI_CLI_TRUST_WORKSPACE=true \
        GM_CWD_TTY_POLICY=cwd \
        GM_CWD_NONTTY_POLICY=cwd \
        "$@"
      ;;
    hermes)
      env \
        HM_CWD_TTY_POLICY=cwd \
        HM_CWD_NONTTY_POLICY=cwd \
        "$@"
      ;;
    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

run_with_timeout() {
  local rc

  set +e
  if command -v timeout >/dev/null 2>&1 && [ -n "${AI_ASK_TIMEOUT:-}" ]; then
    timeout "$AI_ASK_TIMEOUT" "$@"
  else
    "$@"
  fi
  rc=$?
  set -e
  return "$rc"
}

maybe_start_bridge() {
  [ "${AI_AUTO_START_BRIDGE:-false}" = "true" ] || return 0
  command -v hgw >/dev/null 2>&1 || return 0
  hgw bridge start >/dev/null 2>&1 || true
}

# >>> ai provider metadata >>>
provider_mgr() {
  case "${1:-}" in
    codex) echo "cm" ;;
    gemini) echo "gm" ;;
    hermes) echo "hm" ;;
    *)
      echo "ERROR: unknown provider kind: ${1:-}" >&2
      return 2
      ;;
  esac
}

provider_default_profile() {
  case "${1:-}" in
    codex) echo "$AI_CODEX_PROFILE" ;;
    gemini) echo "$AI_GEMINI_PROFILE" ;;
    hermes) echo "$AI_HERMES_PROFILE" ;;
    *)
      echo "ERROR: unknown provider kind: ${1:-}" >&2
      return 2
      ;;
  esac
}

provider_label() {
  case "${1:-}" in
    codex|gemini|hermes) echo "$1" ;;
    *)
      echo "ERROR: unknown provider kind: ${1:-}" >&2
      return 2
      ;;
  esac
}

provider_order() {
  if [ -n "${AI_FALLBACK_PROVIDERS:-}" ]; then
    echo "$AI_FALLBACK_PROVIDERS"
  else
    echo "$AI_DEFAULT_PROVIDER"
  fi
}

provider_prepare() {
  local kind="$1"
  local mgr
  mgr="$(provider_mgr "$kind")" || return $?

  need "$mgr" || return $?

  case "$kind" in
    hermes)
      maybe_start_bridge
      ;;
  esac
}

provider_exec_sandbox() {
  local kind="$1"
  shift

  case "$kind" in
    codex)
      exec env \
        CM_CWD_TTY_POLICY=sandbox \
        CM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    gemini)
      exec env \
        GEMINI_CLI_TRUST_WORKSPACE=true \
        GM_CWD_TTY_POLICY=sandbox \
        GM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    hermes)
      exec env \
        HM_CWD_TTY_POLICY=sandbox \
        HM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

provider_run_sandbox_env() {
  local kind="$1"
  shift

  case "$kind" in
    codex)
      env \
        CM_CWD_TTY_POLICY=sandbox \
        CM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    gemini)
      env \
        GEMINI_CLI_TRUST_WORKSPACE=true \
        GM_CWD_TTY_POLICY=sandbox \
        GM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    hermes)
      env \
        HM_CWD_TTY_POLICY=sandbox \
        HM_CWD_NONTTY_POLICY=sandbox \
        "$@"
      ;;

    *)
      echo "ERROR: unknown provider kind: $kind" >&2
      return 2
      ;;
  esac
}

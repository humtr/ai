{
  "providers": {
    "codex": {
      "label": "Codex",
      "binary": "codex",
      "profile": {
        "supported": true,
        "base_dir": "~/.codex-profiles",
        "strategy": "env_home",
        "env_var": "CODEX_HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "codex_resume",
        "supports_all": true,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "sandbox",
          "label": "Sandbox",
          "flag": "--sandbox",
          "type": "choice",
          "choices": ["danger-full-access (default)", "dangerously-bypass-approvals-and-sandbox"],
          "default": "danger-full-access (default)",
          "args_map": {
            "danger-full-access (default)": [],
            "danger-full-access": ["--sandbox", "danger-full-access"],
            "dangerously-bypass-approvals-and-sandbox": ["--dangerously-bypass-approvals-and-sandbox"],
            "danger-bypass": ["--dangerously-bypass-approvals-and-sandbox"]
          }
        },
        {
          "id": "approval",
          "label": "Approval",
          "flag": "--ask-for-approval",
          "type": "choice",
          "choices": ["on-request (default)", "never"],
          "default": "on-request (default)",
          "args_map": {
            "on-request (default)": [],
            "on-request": ["--ask-for-approval", "on-request"],
            "never": ["--ask-for-approval", "never"]
          }
        },
        {
          "id": "reviewer",
          "label": "Reviewer",
          "type": "choice",
          "choices": ["auto_review (default)", "human"],
          "default": "auto_review (default)",
          "args_map": {
            "auto_review (default)": [],
            "auto_review": ["-c", "approvals_reviewer=\"auto_review\""],
            "auto (default)": [],
            "auto": ["-c", "approvals_reviewer=\"auto_review\""],
            "human": ["-c", "approvals_reviewer=\"human\""]
          }
        },
        {
          "id": "context",
          "label": "Context",
          "flag": "-c",
          "type": "choice",
          "choices": ["272k (default)", "372k", "1M", "custom"],
          "default": "272k (default)",
          "args_map": {
            "272k (default)": [],
            "272k": [
              "-c", "model_context_window=272000"
            ],
            "372k": [
              "-c", "model_context_window=372000"
            ],
            "1M": [
              "-c", "model_context_window=1000000"
            ]
          }
        },
        {
          "id": "context_mgmt",
          "label": "Ctx Mgmt",
          "type": "choice",
          "choices": ["on (default)", "off"],
          "default": "on (default)",
          "args_map": {
            "on (default)": [],
            "on": ["--enable", "context_management"],
            "off": ["--disable", "context_management"]
          }
        },
        {
          "id": "compact",
          "label": "Compact",
          "flag": "-c",
          "type": "choice",
          "choices": ["off (default)", "90%", "85%", "-30k", "custom"],
          "default": "off (default)"
        },
        {
          "id": "search",
          "label": "Search",
          "flag": "--search",
          "type": "choice",
          "choices": ["off (default)", "on"],
          "default": "off (default)",
          "args_map": {
            "off (default)": [],
            "on": ["--search"],
            "off": []
          }
        }
      ]
    },
    "agy": {
      "label": "Agy",
      "binary": "agy",
      "profile": {
        "supported": true,
        "base_dir": "~/.agy-profiles",
        "strategy": "env_home",
        "env_var": "HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "agy_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "skip_permissions",
          "label": "Auto-Approve",
          "flag": "--dangerously-skip-permissions",
          "type": "toggle",
          "default": false
        },
        {
          "id": "mode",
          "label": "Mode",
          "flag": "--mode",
          "type": "choice",
          "choices": ["normal (default)", "plan", "accept-edits"],
          "default": "normal (default)",
          "args_map": {
            "normal (default)": [],
            "normal": ["--mode", "normal"],
            "plan": ["--mode", "plan"],
            "accept-edits": ["--mode", "accept-edits"]
          }
        },
        {
          "id": "effort",
          "label": "Effort",
          "flag": "--effort",
          "type": "choice",
          "choices": ["auto (default)", "low", "medium", "high"],
          "default": "auto (default)",
          "args_map": {
            "auto (default)": [],
            "auto": ["--effort", "auto"],
            "low": ["--effort", "low"],
            "medium": ["--effort", "medium"],
            "high": ["--effort", "high"]
          }
        }
      ]
    },
    "hermes": {
      "label": "Hermes",
      "binary": "hermes",
      "profile": {
        "supported": true,
        "base_dir": "~/.hermes/profiles",
        "strategy": "native_arg",
        "arg": "--profile",
        "fallback_strategy": "profile_use"
      },
      "session": {
        "supported": true,
        "strategy": "hermes_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "yes",
          "label": "Auto-Confirm",
          "flag": "-y",
          "type": "toggle",
          "default": false
        }
      ]
    },
    "opencode": {
      "label": "OpenCode",
      "binary": "opencode",
      "profile": {
        "supported": true,
        "base_dir": "~/.opencode-profiles",
        "strategy": "env_home",
        "env_var": "HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "opencode_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "auto",
          "label": "Auto-Approve",
          "flag": "--auto",
          "type": "toggle",
          "default": false
        },
        {
          "id": "mini",
          "label": "Mini UI",
          "flag": "--mini",
          "type": "toggle",
          "default": false
        }
      ]
    }
  }
}

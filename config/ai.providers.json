{
  "providers": {
    "codex": {
      "label": "Codex",
      "binary": "codex",
      "profile": {
        "supported": true,
        "base_dir": "~/.codex-profiles",
        "strategy": "env_home",
        "env_var": "CODEX_HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "codex_resume",
        "supports_all": true,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "sandbox",
          "label": "Sandbox",
          "flag": "--sandbox",
          "type": "choice",
          "choices": ["off", "danger-full-access", "workspace-write", "read-only"],
          "default": "off"
        },
        {
          "id": "approval",
          "label": "Approval",
          "flag": "--ask-for-approval",
          "type": "choice",
          "choices": ["off", "never", "on-request"],
          "default": "off"
        },
        {
          "id": "search",
          "label": "Search",
          "flag": "--search",
          "type": "toggle",
          "default": false
        },
        {
          "id": "context",
          "label": "Context",
          "flag": "-c",
          "type": "choice",
          "choices": ["off", "200k", "500k", "1M", "1050k", "2M"],
          "default": "off",
          "args_map": {
            "200k": [
              "-c", "model_context_window=200000",
              "-c", "model_auto_compact_token_limit=180000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ],
            "500k": [
              "-c", "model_context_window=500000",
              "-c", "model_auto_compact_token_limit=450000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ],
            "1M": [
              "-c", "model_context_window=1000000",
              "-c", "model_auto_compact_token_limit=900000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ],
            "1050k": [
              "-c", "model_context_window=1050000",
              "-c", "model_auto_compact_token_limit=900000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ],
            "1.05M": [
              "-c", "model_context_window=1050000",
              "-c", "model_auto_compact_token_limit=900000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ],
            "2M": [
              "-c", "model_context_window=2000000",
              "-c", "model_auto_compact_token_limit=1800000",
              "-c", "model_auto_compact_token_limit_scope=total"
            ]
          }
        }
      ]
    },
    "agy": {
      "label": "Agy",
      "binary": "agy",
      "profile": {
        "supported": true,
        "base_dir": "~/.agy-profiles",
        "strategy": "env_home",
        "env_var": "HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "agy_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "skip_permissions",
          "label": "Auto-Approve",
          "flag": "--dangerously-skip-permissions",
          "type": "toggle",
          "default": false
        },
        {
          "id": "mode",
          "label": "Mode",
          "flag": "--mode",
          "type": "choice",
          "choices": ["off", "plan", "accept-edits"],
          "default": "off"
        },
        {
          "id": "effort",
          "label": "Effort",
          "flag": "--effort",
          "type": "choice",
          "choices": ["off", "low", "medium", "high"],
          "default": "off"
        }
      ]
    },
    "hermes": {
      "label": "Hermes",
      "binary": "hermes",
      "profile": {
        "supported": true,
        "base_dir": "~/.hermes/profiles",
        "strategy": "native_arg",
        "arg": "--profile",
        "fallback_strategy": "profile_use"
      },
      "session": {
        "supported": true,
        "strategy": "hermes_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "yes",
          "label": "Auto-Confirm",
          "flag": "-y",
          "type": "toggle",
          "default": false
        }
      ]
    },
    "opencode": {
      "label": "OpenCode",
      "binary": "opencode",
      "profile": {
        "supported": true,
        "base_dir": "~/.opencode-profiles",
        "strategy": "env_home",
        "env_var": "HOME",
        "default_uses_native_home": true
      },
      "session": {
        "supported": true,
        "strategy": "opencode_resume",
        "supports_all": false,
        "supports_specific_ref": true,
        "supports_picker": true,
        "supports_last": true
      },
      "options": [
        {
          "id": "auto",
          "label": "Auto-Approve",
          "flag": "--auto",
          "type": "toggle",
          "default": false
        },
        {
          "id": "mini",
          "label": "Mini UI",
          "flag": "--mini",
          "type": "toggle",
          "default": false
        }
      ]
    }
  }
}

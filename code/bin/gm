#!/data/data/com.termux/files/usr/bin/bash
# gm = Gemini Manager
set -euo pipefail

# >>> gm cwd policy >>>
# Shared cwd policy loaded from:
#   ~/.config/ai/lib/manager_cwd_policy.sh
#
# Environment overrides:
#   GM_CWD_TTY_POLICY=ask|cwd|sandbox
#   GM_CWD_NONTTY_POLICY=cwd|sandbox
#   GM_CWD_ASK_DEFAULT=cwd|sandbox

__mgr_name="gm"
__mgr_profile_home="$HOME/.gemini-profiles"
__mgr_sb_root="$HOME/sb/gemini"
__mgr_tty_policy="${GM_CWD_TTY_POLICY:-ask}"
__mgr_non_tty_policy="${GM_CWD_NONTTY_POLICY:-sandbox}"
__mgr_ask_default="${GM_CWD_ASK_DEFAULT:-sandbox}"
__mgr_force_policy=""

if [ "${1:-}" = "sb" ] || [ "${1:-}" = "sandbox" ]; then
  __mgr_force_policy="sandbox"
  shift
fi

__mgr_cmd="${1:-}"
__mgr_profile="${2:-}"

# shellcheck source=/dev/null
. "$HOME/.config/ai/lib/manager_cwd_policy.sh"

__mgr_rc=0
ai_mgr_maybe_cd \
  "$__mgr_name" \
  "$__mgr_profile_home" \
  "$__mgr_sb_root" \
  "$__mgr_cmd" \
  "$__mgr_profile" \
  "$__mgr_force_policy" \
  "$__mgr_tty_policy" \
  "$__mgr_non_tty_policy" \
  "$__mgr_ask_default" \
  "ask task chat plan run raw" || __mgr_rc=$?

unset -f ai_mgr_maybe_cd
unset __mgr_name __mgr_profile_home __mgr_sb_root __mgr_tty_policy __mgr_non_tty_policy __mgr_ask_default __mgr_force_policy __mgr_cmd __mgr_profile

if [ "$__mgr_rc" -ne 0 ]; then
  exit "$__mgr_rc"
fi
unset __mgr_rc
# <<< gm cwd policy <<<


# >>> gm throttle after Gemini prompt calls >>>
# Default throttle between completed Gemini prompt calls.
# Disable per-call with:
#   GM_THROTTLE_SEC=0 gm ...
GM_THROTTLE_SEC="${GM_THROTTLE_SEC:-2}"

gm_throttle_sleep() {
  local sec="${GM_THROTTLE_SEC:-0}"
  case "$sec" in
    ""|0|0.0|0.00) return 0 ;;
  esac
  sleep "$sec"
}

gm_has_prompt_arg() {
  local a
  for a in "$@"; do
    case "$a" in
      -p|--prompt|--prompt=*)
        return 0
        ;;
    esac
  done
  return 1
}

gm_run_gemini_prompt() {
  local run_home="$1"
  local prompt="$2"
  local rc old_errexit=0

  case "$-" in *e*) old_errexit=1; set +e ;; esac
  HOME="$run_home" gemini --skip-trust -p "$prompt" < /dev/null
  rc=$?
  [ "$old_errexit" = 1 ] && set -e

  gm_throttle_sleep
  return "$rc"
}

gm_run_gemini_native() {
  local run_home="$1"
  shift

  local rc old_errexit=0
  case "$-" in *e*) old_errexit=1; set +e ;; esac
  HOME="$run_home" gemini "$@"
  rc=$?
  [ "$old_errexit" = 1 ] && set -e

  if gm_has_prompt_arg "$@"; then
    gm_throttle_sleep
  fi

  return "$rc"
}
# <<< gm throttle after Gemini prompt calls >>>





BASE="$HOME/.gemini-profiles"
ACTIVE_LINK="$HOME/.gemini"
DELETED="$HOME/.gemini-profiles.deleted"

mkdir -p "$BASE"

usage() {
  cat <<USAGE
gm = Gemini Manager

Profiles:
  gm profile [list]
  gm profile show <profile>
  gm profile add <profile>
  gm profile use <profile>
  gm profile edit <profile>
  gm profile rename <old> <new>
  gm profile clone <source> <target> [--without-auth]
  gm profile delete <profile>

Execution:
  gm run [profile] [-- gemini args...]          # interactive Gemini CLI
  gm ask [profile] [PROMPT...]                  # no-tool chat
  gm chat [profile] [PROMPT...]                 # same as ask
  gm task [profile] [PROMPT...]                 # tool-capable Gemini task
  gm plan [profile] [PROMPT...]                 # plan-only prompt
  gm raw [profile] [-- gemini args...]          # native Gemini passthrough

Input:
  gm ask tg "hi"
  gm chat tg "explain this"
  gm task tg "read files and summarize"
  gm plan tg "plan the fix only"
  gm task tg - < prompt.md
  cat README.md | gm task tg "Summarize this"

Native passthrough:
  gm raw tg -- --version
  gm raw tg -- -p "Reply with only: OK"
  gm task tg -- -p "Return JSON only" --output-format json

CWD policy:
  gm sb <command> <profile> ...                 # legacy: force ~/sb/gemini
  gm sandbox <command> <profile> ...            # same as sb
  GM_CWD_TTY_POLICY=ask|cwd|sandbox
  GM_CWD_NONTTY_POLICY=cwd|sandbox

Throttle:
  GM_THROTTLE_SEC=2 is the default for Gemini prompt calls.
  GM_THROTTLE_SEC=0 gm ... disables it for one call.

Notes:
  ask/chat = no-tool answer mode.
  task     = tool-capable mode.
  plan     = plan-only mode.
  raw      = exact native Gemini CLI passthrough.
USAGE
}

valid_name() {
  case "$1" in
    ""|.*|*/*|*" "*) return 1 ;;
    *) return 0 ;;
  esac
}

profile_path() {
  echo "$BASE/$1"
}

active_profile() {
  local resolved
  resolved="$(readlink -f "$ACTIVE_LINK" 2>/dev/null || true)"

  if [ -n "$resolved" ]; then
    find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null |
    while IFS= read -r p; do
      if [ "$(readlink -f "$(profile_path "$p")")" = "$resolved" ]; then
        echo "$p"
        return 0
      fi
    done
  fi
}

default_profile() {
  local active
  active="$(active_profile || true)"
  if [ -n "$active" ]; then
    echo "$active"
  else
    echo "main"
  fi
}

require_profile() {
  local p="$1"
  [ -d "$(profile_path "$p")" ] || {
    echo "ERROR: Gemini profile not found: $p" >&2
    echo >&2
    echo "Available profiles:" >&2
    find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null | sort >&2
    exit 1
  }
}

profile_from_cwd() {
  local cur rel prof
  cur="$(pwd -P 2>/dev/null || pwd)"

  case "$cur" in
    "$HOME/sb/gemini")
      return 1
      ;;
    "$HOME/sb"/*)
      rel="${cur#"$HOME/sb"/}"
      prof="${rel%%/*}"

      if [ -n "$prof" ] && [ -d "$(profile_path "$prof")" ]; then
        echo "$prof"
        return 0
      fi
      ;;
  esac

  return 1
}

parse_profile_first() {
  # Explicit profile always wins:
  #   gm task tg "prompt"
  if [ -n "${1:-}" ] && [ -d "$(profile_path "$1")" ]; then
    echo "$1"
    return 0
  fi

  # If invoked from a flat profile sandbox, use that profile:
  #   cd ~/sb/tg
  #   gm task "prompt"  -> tg
  local cwd_profile
  cwd_profile="$(profile_from_cwd 2>/dev/null || true)"
  if [ -n "$cwd_profile" ]; then
    echo "$cwd_profile"
    return 0
  fi

  default_profile
}

list_profiles() {
  local active
  active="$(active_profile || true)"

  echo "== Gemini profiles =="

  find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort |
  while IFS= read -r p; do
    local home marker oauth accounts settings trusted
    home="$(profile_path "$p")"
    marker=" "
    [ "$p" = "$active" ] && marker="◆"

    oauth="no-oauth"
    [ -f "$home/oauth_creds.json" ] && oauth="oauth"

    accounts="no-accounts"
    [ -f "$home/google_accounts.json" ] && accounts="accounts"

    settings="no-settings"
    [ -f "$home/settings.json" ] && settings="settings"

    trusted="no-trusted"
    [ -f "$home/trustedFolders.json" ] && trusted="trusted"

    printf " %s %-12s %-10s %-12s %-12s %-12s %s\n" \
      "$marker" "$p" "$oauth" "$accounts" "$settings" "$trusted" "$home"
  done

  echo
  echo "Active: ${active:-none}"
  echo "Resolved ~/.gemini: $(readlink -f "$ACTIVE_LINK" 2>/dev/null || true)"
}

show_profile() {
  local p="$1"
  require_profile "$p"

  local home
  home="$(profile_path "$p")"

  echo "Profile:  $p"
  echo "Path:     $home"
  [ -f "$home/oauth_creds.json" ] && echo "OAuth:    exists" || echo "OAuth:    missing"
  [ -f "$home/google_accounts.json" ] && echo "Account:  exists" || echo "Account:  missing"
  [ -f "$home/settings.json" ] && echo "Settings: exists" || echo "Settings: missing"
  [ -f "$home/trustedFolders.json" ] && echo "Trusted:  exists" || echo "Trusted:  missing"
}

add_profile() {
  local p="$1"

  valid_name "$p" || {
    echo "ERROR: invalid profile name: $p" >&2
    exit 1
  }

  if [ -e "$(profile_path "$p")" ]; then
    echo "Already exists: $p"
  else
    mkdir -p "$(profile_path "$p")"
    echo "Created Gemini profile: $p"
  fi
}

use_profile() {
  local p="$1"
  require_profile "$p"

  if [ -e "$ACTIVE_LINK" ] && [ ! -L "$ACTIVE_LINK" ]; then
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    echo "Backing up existing real ~/.gemini to ~/.gemini.backup.$ts"
    mv "$ACTIVE_LINK" "$HOME/.gemini.backup.$ts"
  fi

  ln -sfn "$(profile_path "$p")" "$ACTIVE_LINK"

  echo "Gemini profile active: $p"
  echo "~/.gemini -> $(readlink -f "$ACTIVE_LINK")"
}

edit_profile() {
  local p="$1"
  require_profile "$p"

  local file editor
  file="$(profile_path "$p")/settings.json"

  if [ ! -f "$file" ]; then
    printf '{}\n' > "$file"
  fi

  editor="${VISUAL:-${EDITOR:-vi}}"
  "$editor" "$file"
}

rename_profile() {
  local old="$1"
  local new="$2"

  require_profile "$old"

  valid_name "$new" || {
    echo "ERROR: invalid new profile name: $new" >&2
    exit 1
  }

  if [ -e "$(profile_path "$new")" ]; then
    echo "ERROR: target already exists: $new" >&2
    exit 1
  fi

  local active_old
  active_old=""
  if [ "$(readlink -f "$ACTIVE_LINK" 2>/dev/null || true)" = "$(readlink -f "$(profile_path "$old")" 2>/dev/null || true)" ]; then
    active_old="yes"
  fi

  mv "$(profile_path "$old")" "$(profile_path "$new")"

  if [ "$active_old" = "yes" ]; then
    ln -sfn "$(profile_path "$new")" "$ACTIVE_LINK"
  fi

  echo "Renamed Gemini profile: $old -> $new"
}

clone_profile() {
  local src="$1"
  local dst="$2"
  local mode="${3:-}"

  require_profile "$src"

  valid_name "$dst" || {
    echo "ERROR: invalid target profile name: $dst" >&2
    exit 1
  }

  if [ -e "$(profile_path "$dst")" ]; then
    echo "ERROR: target already exists: $dst" >&2
    exit 1
  fi

  mkdir -p "$(profile_path "$dst")"
  cp -a "$(profile_path "$src")/." "$(profile_path "$dst")/"

  if [ "$mode" = "--without-auth" ]; then
    rm -f "$(profile_path "$dst")/oauth_creds.json"
    rm -f "$(profile_path "$dst")/google_accounts.json"
    rm -f "$(profile_path "$dst")/state.json"
  fi

  echo "Cloned Gemini profile: $src -> $dst"
  [ "$mode" = "--without-auth" ] && echo "OAuth/account files removed from target."
}

delete_profile() {
  local p="$1"
  require_profile "$p"

  local active
  active="$(active_profile || true)"

  if [ "$p" = "$active" ]; then
    echo "ERROR: cannot delete active profile: $p" >&2
    echo "Switch first: gm profile use main" >&2
    exit 1
  fi

  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$DELETED"

  mv "$(profile_path "$p")" "$DELETED/$p.$ts"
  echo "Moved deleted Gemini profile to:"
  echo "  $DELETED/$p.$ts"
}

run_home_for_profile() {
  local p="$1"
  local run_home
  run_home="$HOME/.cache/gm/direct-home-$p"
  mkdir -p "$run_home"
  ln -sfn "$(profile_path "$p")" "$run_home/.gemini"
  echo "$run_home"
}

load_profile_env() {
  local p="$1"
  local f="$HOME/.config/gm/env/$p"
  if [ -f "$f" ]; then
    # shellcheck disable=SC1090
    . "$f"
  fi
}

run_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  use_profile "$p" >/dev/null

  echo "Gemini profile: $p"
  echo "~/.gemini -> $(readlink -f "$ACTIVE_LINK")"
  echo

  exec gemini "$@"
}


gm_task_guard_prefix() {
  cat <<'EOF'
도구 사용 가능 작업 모드다.
단, 실제로 제공된 도구만 사용하고, 존재하지 않는 도구명이나 API를 만들지 마라.
도구가 필요 없는 요청이면 도구를 사용하지 말고 바로 답하라.
사용자가 "정확히", "토큰만", "한 문장만" 같은 출력 제약을 주면 그 출력 제약을 최우선으로 지켜라.
EOF
}

task_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  require_profile "$p"

  local run_home
  run_home="$(run_home_for_profile "$p")"
  load_profile_env "$p"

  # Native passthrough mode.
  # Everything after -- is passed to gemini exactly.
  #
  # Examples:
  #   gm task tg -- -p "prompt" --output-format json
  #   gm task tg -- --skip-trust -p "prompt"
  if [ "${1:-}" = "--" ]; then
    shift
    gm_run_gemini_native "$run_home" "$@"; exit "$?"
  fi

  # Friendly prompt mode.
  #
  # Examples:
  #   gm task tg "prompt"
  #   gm task tg -
  #   cat README.md | gm task tg "Summarize this"
  #
  # No automatic --skip-trust here. Trust policy is Gemini-native.
  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage:" >&2
      echo "  gm task [profile] PROMPT" >&2
      echo "  gm task [profile] - < prompt.md" >&2
      echo "  gm task [profile] -- <gemini native args...>" >&2
      exit 2
    fi
    HOME="$run_home" exec gemini
  fi

  case "$1" in
    -)
      local prompt
      prompt="$(cat)"
      local guarded_prompt
      guarded_prompt="$(gm_task_guard_prefix)

$prompt"
      gm_run_gemini_prompt "$run_home" "$guarded_prompt"; exit "$?"
      ;;
    -*)
      echo "ERROR: Gemini native flags must come after --" >&2
      echo >&2
      echo "Examples:" >&2
      echo "  gm task tg -- -p \"prompt\" --output-format json" >&2
      echo "  gm task tg -- --skip-trust -p \"prompt\"" >&2
      exit 2
      ;;
    *)
      local prompt
      prompt="$*"
      local guarded_prompt
      guarded_prompt="$(gm_task_guard_prefix)

$prompt"
      gm_run_gemini_prompt "$run_home" "$guarded_prompt"; exit "$?"
      ;;
  esac
}

raw_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  local run_home
  run_home="$(run_home_for_profile "$p")"
  load_profile_env "$p"

  gm_run_gemini_native "$run_home" "$@"; exit "$?"
}

status_cmd() {
  list_profiles

  echo
  echo "== Gemini binary =="
  command -v gemini 2>/dev/null || true
  gemini --version 2>/dev/null || true
}

doctor_cmd() {
  echo "== Gemini doctor =="

  echo
  echo "Paths:"
  command -v gemini 2>/dev/null || true
  command -v node 2>/dev/null || true
  command -v npm 2>/dev/null || true

  echo
  echo "Versions:"
  gemini --version 2>/dev/null || true
  node -v 2>/dev/null || true
  npm -v 2>/dev/null || true

  echo
  echo "Global packages:"
  npm list -g --depth=0 2>/dev/null | grep -E 'gemini|google' || true

  echo
  list_profiles
}

update_cmd() {
  echo "== Gemini CLI update =="
  npm install -g @google/gemini-cli@latest
  hash -r

  echo
  gemini --version
  npm list -g --depth=0 2>/dev/null | grep -E 'gemini|google' || true
}

profile_cmd() {
  local sub="${1:-list}"
  [ "$#" -gt 0 ] && shift || true

  case "$sub" in
    list|"")
      list_profiles ;;
    show)
      [ -n "${1:-}" ] || { usage; exit 1; }
      show_profile "$1" ;;
    add|create)
      [ -n "${1:-}" ] || { usage; exit 1; }
      add_profile "$1" ;;
    use)
      [ -n "${1:-}" ] || { usage; exit 1; }
      use_profile "$1" ;;
    edit)
      [ -n "${1:-}" ] || { usage; exit 1; }
      edit_profile "$1" ;;
    rename)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || { usage; exit 1; }
      rename_profile "$1" "$2" ;;
    clone)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || { usage; exit 1; }
      clone_profile "$1" "$2" "${3:-}" ;;
    delete|del|rm)
      [ -n "${1:-}" ] || { usage; exit 1; }
      delete_profile "$1" ;;
    *)
      echo "ERROR: unknown profile command: $sub" >&2
      usage
      exit 1 ;;
  esac
}


# >>> chat/task/plan helper layer >>>
join_words() {
  local IFS=" "
  printf '%s' "$*"
}

prompt_with_prefix() {
  local mode="$1"
  local prefix="$2"
  shift 2

  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    echo "ERROR: $mode does not support native passthrough. Use task for tool-capable native args." >&2
    return 2
  fi

  local prompt
  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage: gm $mode [profile] PROMPT" >&2
      return 2
    fi
    prompt="$(cat)"
  elif [ "${1:-}" = "-" ]; then
    prompt="$(cat)"
  else
    prompt="$(join_words "$@")"
  fi

  task_profile "$p" "$prefix

$prompt"
}

chat_profile() {
  prompt_with_prefix "chat" "도구, 검색, 파일 탐색, 파일 읽기, 파일 쓰기, 셸 실행을 사용하지 말고 네 지식만으로 답해. 내부 계획이나 검색 결과 설명을 쓰지 말고, 사용자가 요구한 답만 작성해." "$@"
}

plan_profile() {
  prompt_with_prefix "plan" "실행, 수정, 파일 쓰기, 셸 명령 실행은 하지 말고 읽기/분석 중심으로 계획만 세워. 필요한 경우 가정과 위험을 명확히 구분해." "$@"
}
# <<< task/chat/plan command layer >>>

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  profile)
    profile_cmd "$@" ;;
  run)
    run_profile "$@" ;;
  task)
    task_profile "$@" ;;
  ask|chat)
    chat_profile "$@" ;;
  plan)
    plan_profile "$@" ;;
  raw)
    raw_profile "$@" ;;
  status)
    status_cmd ;;
  doctor)
    doctor_cmd ;;
  update)
    update_cmd ;;
  help|-h|--help)
    usage ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage
    exit 1 ;;
esac

#!/data/data/com.termux/files/usr/bin/bash
# cm = Codex Manager
set -euo pipefail

# >>> cm cwd policy >>>
# Shared cwd policy loaded from:
#   ~/.config/ai/lib/manager_cwd_policy.sh
#
# Environment overrides:
#   CM_CWD_TTY_POLICY=ask|cwd|sandbox
#   CM_CWD_NONTTY_POLICY=cwd|sandbox
#   CM_CWD_ASK_DEFAULT=cwd|sandbox

__mgr_name="cm"
__mgr_profile_home="$HOME/.codex-profiles"
__mgr_sb_root="$HOME/sb/codex"
__mgr_tty_policy="${CM_CWD_TTY_POLICY:-ask}"
__mgr_non_tty_policy="${CM_CWD_NONTTY_POLICY:-cwd}"
__mgr_ask_default="${CM_CWD_ASK_DEFAULT:-cwd}"
__mgr_force_policy=""

if [ "${1:-}" = "sb" ] || [ "${1:-}" = "sandbox" ]; then
  __mgr_force_policy="sandbox"
  shift
fi

__mgr_cmd="${1:-}"
__mgr_profile="${2:-}"

# shellcheck source=/dev/null
. "$HOME/.config/ai/lib/manager_cwd_policy.sh"

__mgr_rc=0
ai_mgr_maybe_cd \
  "$__mgr_name" \
  "$__mgr_profile_home" \
  "$__mgr_sb_root" \
  "$__mgr_cmd" \
  "$__mgr_profile" \
  "$__mgr_force_policy" \
  "$__mgr_tty_policy" \
  "$__mgr_non_tty_policy" \
  "$__mgr_ask_default" \
  "ask task chat plan run exec raw" || __mgr_rc=$?

unset -f ai_mgr_maybe_cd
unset __mgr_name __mgr_profile_home __mgr_sb_root __mgr_tty_policy __mgr_non_tty_policy __mgr_ask_default __mgr_force_policy __mgr_cmd __mgr_profile

if [ "$__mgr_rc" -ne 0 ]; then
  exit "$__mgr_rc"
fi
unset __mgr_rc
# <<< cm cwd policy <<<




BASE="$HOME/.codex-profiles"
CONFIG="$HOME/.config/cm"
CURRENT="$CONFIG/current"
DELETED="$HOME/.codex-profiles.deleted"

mkdir -p "$BASE" "$CONFIG"

usage() {
  cat <<USAGE
cm = Codex Manager

Profiles:
  cm profile [list]
  cm profile show <profile>
  cm profile add <profile>
  cm profile use <profile>
  cm profile edit <profile>
  cm profile rename <old> <new>
  cm profile clone <source> <target> [--without-auth]
  cm profile delete <profile>

Execution:
  cm run [profile] [-- codex args...]           # interactive Codex CLI
  cm ask [profile] [PROMPT...]                  # no-tool chat
  cm chat [profile] [PROMPT...]                 # same as ask
  cm task [profile] [PROMPT...]                 # tool-capable Codex task
  cm plan [profile] [PROMPT...]                 # plan-only prompt
  cm exec [profile] [codex exec args...]        # native codex exec passthrough
  cm raw [profile] [-- codex args...]           # native Codex passthrough

Input:
  cm ask main "hi"
  cm chat main "explain this"
  cm task main "inspect files and fix"
  cm plan main "plan the refactor only"
  cm task main - < prompt.md
  cat README.md | cm task main "Summarize this"

Native passthrough:
  cm raw main -- --version
  cm exec main --json "Native codex exec prompt"
  cm exec main -- --json "Native codex exec prompt"
  cm task main -- --json "Tool-capable task"

CWD policy:
  cm sb <command> <profile> ...                 # legacy: force ~/sb/codex
  cm sandbox <command> <profile> ...            # same as sb
  CM_CWD_TTY_POLICY=ask|cwd|sandbox
  CM_CWD_NONTTY_POLICY=cwd|sandbox

Notes:
  ask/chat = no-tool answer mode.
  task     = tool-capable mode.
  plan     = plan-only mode.
  exec     = native codex exec passthrough.
  raw      = exact native Codex CLI passthrough.
USAGE
}

valid_name() {
  case "$1" in
    ""|.*|*/*|*" "*) return 1 ;;
    *) return 0 ;;
  esac
}

profile_path() {
  echo "$BASE/$1"
}

active_profile() {
  if [ -f "$CURRENT" ]; then
    cat "$CURRENT"
  else
    echo "main"
  fi
}

require_profile() {
  local p="$1"
  [ -d "$(profile_path "$p")" ] || {
    echo "ERROR: Codex profile not found: $p" >&2
    echo >&2
    echo "Available profiles:" >&2
    find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null | sort >&2
    exit 1
  }
}

parse_profile_first() {
  if [ -n "${1:-}" ] && [ -d "$(profile_path "$1")" ]; then
    echo "$1"
  else
    active_profile
  fi
}

list_profiles() {
  local active
  active="$(active_profile)"

  echo "== Codex profiles =="

  find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort |
  while IFS= read -r p; do
    local home marker auth config hist logs
    home="$(profile_path "$p")"
    marker=" "
    [ "$p" = "$active" ] && marker="◆"

    auth="no-auth"
    [ -f "$home/auth.json" ] && auth="auth"

    config="no-config"
    [ -f "$home/config.toml" ] && config="config"

    hist="no-history"
    [ -f "$home/history.jsonl" ] && hist="history"

    logs="no-log"
    [ -d "$home/log" ] && logs="log"

    printf " %s %-10s %-9s %-10s %-11s %-8s %s\n" \
      "$marker" "$p" "$auth" "$config" "$hist" "$logs" "$home"
  done

  echo
  echo "Active: $active"
}

show_profile() {
  local p="$1"
  require_profile "$p"

  local home
  home="$(profile_path "$p")"

  echo "Profile: $p"
  echo "Path:    $home"
  [ -f "$home/auth.json" ] && echo "Auth:    exists" || echo "Auth:    missing"
  [ -f "$home/config.toml" ] && echo "Config:  exists" || echo "Config:  missing"
  [ -f "$home/history.jsonl" ] && echo "History: exists" || echo "History: missing"
  [ -d "$home/log" ] && echo "Logs:    exists" || echo "Logs:    missing"
}

add_profile() {
  local p="$1"

  valid_name "$p" || {
    echo "ERROR: invalid profile name: $p" >&2
    exit 1
  }

  if [ -e "$(profile_path "$p")" ]; then
    echo "Already exists: $p"
  else
    mkdir -p "$(profile_path "$p")"
    echo "Created Codex profile: $p"
  fi
}

use_profile() {
  local p="$1"
  require_profile "$p"

  printf '%s\n' "$p" > "$CURRENT"

  echo "Codex profile active: $p"
  echo "CODEX_HOME=$(profile_path "$p")"
}

edit_profile() {
  local p="$1"
  require_profile "$p"

  local file editor
  file="$(profile_path "$p")/config.toml"
  touch "$file"

  editor="${VISUAL:-${EDITOR:-vi}}"
  "$editor" "$file"
}

rename_profile() {
  local old="$1"
  local new="$2"

  require_profile "$old"

  valid_name "$new" || {
    echo "ERROR: invalid new profile name: $new" >&2
    exit 1
  }

  if [ -e "$(profile_path "$new")" ]; then
    echo "ERROR: target already exists: $new" >&2
    exit 1
  fi

  mv "$(profile_path "$old")" "$(profile_path "$new")"

  if [ "$(active_profile)" = "$old" ]; then
    printf '%s\n' "$new" > "$CURRENT"
  fi

  echo "Renamed Codex profile: $old -> $new"
}

clone_profile() {
  local src="$1"
  local dst="$2"
  local mode="${3:-}"

  require_profile "$src"

  valid_name "$dst" || {
    echo "ERROR: invalid target profile name: $dst" >&2
    exit 1
  }

  if [ -e "$(profile_path "$dst")" ]; then
    echo "ERROR: target already exists: $dst" >&2
    exit 1
  fi

  mkdir -p "$(profile_path "$dst")"
  cp -a "$(profile_path "$src")/." "$(profile_path "$dst")/"

  if [ "$mode" = "--without-auth" ]; then
    rm -f "$(profile_path "$dst")/auth.json"
  fi

  echo "Cloned Codex profile: $src -> $dst"
  [ "$mode" = "--without-auth" ] && echo "Auth removed from target."
}

delete_profile() {
  local p="$1"
  require_profile "$p"

  local active
  active="$(active_profile)"

  if [ "$p" = "$active" ]; then
    echo "ERROR: cannot delete active profile: $p" >&2
    echo "Switch first: cm profile use main" >&2
    exit 1
  fi

  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$DELETED"

  mv "$(profile_path "$p")" "$DELETED/$p.$ts"
  echo "Moved deleted Codex profile to:"
  echo "  $DELETED/$p.$ts"
}

with_codex_home() {
  local p="$1"
  shift

  require_profile "$p"
  export CODEX_HOME
  CODEX_HOME="$(profile_path "$p")"

  exec "$@"
}

run_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  echo "Codex profile: $p"
  echo "CODEX_HOME=$(profile_path "$p")"
  echo

  with_codex_home "$p" codex "$@"
}

task_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  require_profile "$p"
  export CODEX_HOME
  CODEX_HOME="$(profile_path "$p")"

  # Native passthrough mode.
  #
  # Everything after -- is passed to `codex exec` exactly as provided.
  # No stderr suppression, no injected flags, no output filtering.
  #
  # Examples:
  #   cm task -- --json "prompt"
  #   cm task main -- --output-schema schema.json -o result.json "prompt"
  if [ "${1:-}" = "--" ]; then
    shift
    exec codex exec "$@"
  fi

  # Friendly prompt mode.
  #
  # Manager convenience mode:
  #   - adds --skip-git-repo-check
  #   - hides Codex progress/banner stderr
  #   - preserves final stdout
  #
  # Examples:
  #   cm task "prompt"
  #   cm task main "prompt"
  #   cat prompt.md | cm task main -
  local skip_git_flag
  skip_git_flag="--skip-git-repo-check"

  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage:" >&2
      echo "  cm task [profile] PROMPT" >&2
      echo "  cm task [profile] - < prompt.md" >&2
      echo "  cm task [profile] -- <codex exec native args...>" >&2
      exit 2
    fi
    codex exec "$skip_git_flag" - 2>/dev/null
    exit $?
  fi

  case "$1" in
    -)
      codex exec "$skip_git_flag" - 2>/dev/null
      exit $?
      ;;
    -*)
      echo "ERROR: Codex native flags must come after --" >&2
      echo >&2
      echo "Examples:" >&2
      echo "  cm task -- --json \"prompt\"" >&2
      echo "  cm task main -- --skip-git-repo-check --json \"prompt\"" >&2
      echo "  cm task main -- --output-schema schema.json -o result.json \"prompt\"" >&2
      exit 2
      ;;
    *)
      local prompt
      prompt="$*"
      codex exec "$skip_git_flag" "$prompt" 2>/dev/null
      exit $?
      ;;
  esac
}


exec_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  require_profile "$p"
  export CODEX_HOME
  CODEX_HOME="$(profile_path "$p")"

  # Native passthrough mode for codex exec.
  # Optional separator is accepted:
  #   cm exec main --json "prompt"
  #   cm exec main -- --json "prompt"
  if [ "${1:-}" = "--" ]; then
    shift
  fi

  exec codex exec "$@"
}

raw_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  with_codex_home "$p" codex "$@"
}

status_cmd() {
  list_profiles

  echo
  echo "== Codex binary =="
  command -v codex 2>/dev/null || true
  codex --version 2>/dev/null || true

  echo
  echo "== Active login status =="
  local p
  p="$(active_profile)"
  if [ -d "$(profile_path "$p")" ]; then
    CODEX_HOME="$(profile_path "$p")" codex login status 2>&1 || true
  fi
}

doctor_cmd() {
  echo "== Codex doctor =="

  echo
  echo "Paths:"
  command -v codex 2>/dev/null || true
  command -v node 2>/dev/null || true
  command -v npm 2>/dev/null || true

  echo
  echo "Versions:"
  codex --version 2>/dev/null || true
  node -v 2>/dev/null || true
  npm -v 2>/dev/null || true

  echo
  echo "Global packages:"
  npm list -g --depth=0 2>/dev/null | grep -E 'codex|mmmbuto|openai' || true

  echo
  list_profiles

  echo
  echo "Login status by profile:"
  find "$BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort |
  while IFS= read -r p; do
    echo "-- $p --"
    CODEX_HOME="$(profile_path "$p")" codex login status 2>&1 | sed -n '1,8p' || true
  done
}

update_cmd() {
  local ver="${1:-latest}"

  echo "== Codex Termux fork update =="
  echo "Package: @mmmbuto/codex-cli-termux"
  echo "Target: $ver"
  echo

  npm install -g "@mmmbuto/codex-cli-termux@$ver"
  hash -r

  echo
  codex --version
  npm list -g --depth=0 2>/dev/null | grep -E 'codex|mmmbuto|openai' || true
}

profile_cmd() {
  local sub="${1:-list}"
  [ "$#" -gt 0 ] && shift || true

  case "$sub" in
    list|"")
      list_profiles ;;
    show)
      [ -n "${1:-}" ] || { usage; exit 1; }
      show_profile "$1" ;;
    add|create)
      [ -n "${1:-}" ] || { usage; exit 1; }
      add_profile "$1" ;;
    use)
      [ -n "${1:-}" ] || { usage; exit 1; }
      use_profile "$1" ;;
    edit)
      [ -n "${1:-}" ] || { usage; exit 1; }
      edit_profile "$1" ;;
    rename)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || { usage; exit 1; }
      rename_profile "$1" "$2" ;;
    clone)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || { usage; exit 1; }
      clone_profile "$1" "$2" "${3:-}" ;;
    delete|del|rm)
      [ -n "${1:-}" ] || { usage; exit 1; }
      delete_profile "$1" ;;
    *)
      echo "ERROR: unknown profile command: $sub" >&2
      usage
      exit 1 ;;
  esac
}


# >>> chat/task/plan helper layer >>>
join_words() {
  local IFS=" "
  printf '%s' "$*"
}

prompt_with_prefix() {
  local mode="$1"
  local prefix="$2"
  shift 2

  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    echo "ERROR: $mode does not support native passthrough. Use task for tool-capable native args." >&2
    return 2
  fi

  local prompt
  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage: cm $mode [profile] PROMPT" >&2
      return 2
    fi
    prompt="$(cat)"
  elif [ "${1:-}" = "-" ]; then
    prompt="$(cat)"
  else
    prompt="$(join_words "$@")"
  fi

  task_profile "$p" "$prefix

$prompt"
}

chat_profile() {
  prompt_with_prefix "chat" "도구, 검색, 파일 탐색, 파일 읽기, 파일 쓰기, 셸 실행을 사용하지 말고 네 지식만으로 답해. 내부 계획이나 검색 결과 설명을 쓰지 말고, 사용자가 요구한 답만 작성해." "$@"
}

plan_profile() {
  prompt_with_prefix "plan" "실행, 수정, 파일 쓰기, 셸 명령 실행은 하지 말고 읽기/분석 중심으로 계획만 세워. 필요한 경우 가정과 위험을 명확히 구분해." "$@"
}
# <<< task/chat/plan command layer >>>

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  profile)
    profile_cmd "$@" ;;
  run)
    run_profile "$@" ;;
  task)
    task_profile "$@" ;;
  ask|chat)
    chat_profile "$@" ;;
  plan)
    plan_profile "$@" ;;
  exec)
    exec_profile "$@" ;;
  raw)
    raw_profile "$@" ;;
  status)
    status_cmd ;;
  doctor)
    doctor_cmd ;;
  update)
    update_cmd "${1:-latest}" ;;
  help|-h|--help)
    usage ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage
    exit 1 ;;
esac

#!/data/data/com.termux/files/usr/bin/bash
# hm = Hermes Manager
set -euo pipefail

# >>> hm cwd policy >>>
# Shared cwd policy loaded from:
#   ~/.config/ai/lib/manager_cwd_policy.sh
#
# Environment overrides:
#   HM_CWD_TTY_POLICY=ask|cwd|sandbox
#   HM_CWD_NONTTY_POLICY=cwd|sandbox
#   HM_CWD_ASK_DEFAULT=cwd|sandbox

__mgr_name="hm"
__mgr_profile_home="$HOME/.hermes/profiles"
__mgr_sb_root="$HOME/sb/hermes"
__mgr_tty_policy="${HM_CWD_TTY_POLICY:-ask}"
__mgr_non_tty_policy="${HM_CWD_NONTTY_POLICY:-sandbox}"
__mgr_ask_default="${HM_CWD_ASK_DEFAULT:-sandbox}"
__mgr_force_policy=""

if [ "${1:-}" = "sb" ] || [ "${1:-}" = "sandbox" ]; then
  __mgr_force_policy="sandbox"
  shift
fi

__mgr_cmd="${1:-}"
__mgr_profile="${2:-}"

# shellcheck source=/dev/null
. "$HOME/.config/ai/lib/manager_cwd_policy.sh"

__mgr_rc=0
ai_mgr_maybe_cd \
  "$__mgr_name" \
  "$__mgr_profile_home" \
  "$__mgr_sb_root" \
  "$__mgr_cmd" \
  "$__mgr_profile" \
  "$__mgr_force_policy" \
  "$__mgr_tty_policy" \
  "$__mgr_non_tty_policy" \
  "$__mgr_ask_default" \
  "ask task chat plan run raw" || __mgr_rc=$?

unset -f ai_mgr_maybe_cd
unset __mgr_name __mgr_profile_home __mgr_sb_root __mgr_tty_policy __mgr_non_tty_policy __mgr_ask_default __mgr_force_policy __mgr_cmd __mgr_profile

if [ "$__mgr_rc" -ne 0 ]; then
  exit "$__mgr_rc"
fi
unset __mgr_rc
# <<< hm cwd policy <<<




usage() {
  cat <<USAGE
hm = Hermes Manager

Profiles:
  hm profile [list]
  hm profile show <profile>
  hm profile use <profile>
  hm profile edit <profile>

Execution:
  hm run [profile] [-- hermes args...]          # interactive Hermes Agent
  hm ask [profile] [PROMPT...]                  # no-tool chat
  hm chat [profile] [PROMPT...]                 # same as ask
  hm task [profile] [PROMPT...]                 # tool-capable Hermes task
  hm plan [profile] [PROMPT...]                 # plan-only prompt
  hm raw [profile] [-- hermes args...]          # native Hermes passthrough
  hm gateway|gw <args...>                       # hgw passthrough

Input:
  hm ask main "hi"
  hm chat main "explain this"
  hm task main "inspect files and fix"
  hm plan main "plan the refactor only"
  hm task main - < prompt.md

Native passthrough:
  hm raw main -- --version
  hm task main -- -z "Reply with only: OK"
  hm task main -- --ignore-rules -z "Reply with only: OK"

CWD policy:
  hm sb <command> <profile> ...                 # legacy: force ~/sb/hermes
  hm sandbox <command> <profile> ...            # same as sb
  HM_CWD_TTY_POLICY=ask|cwd|sandbox
  HM_CWD_NONTTY_POLICY=cwd|sandbox

Notes:
  ask/chat = no-tool answer mode.
  task     = tool-capable mode.
  plan     = plan-only mode.
  raw      = exact native Hermes passthrough.
  gateway  = hgw passthrough.
USAGE
}

is_profile() {
  [ -n "${1:-}" ] && [ -d "$HOME/.hermes/profiles/$1" ]
}

parse_profile_first() {
  if is_profile "${1:-}"; then
    echo "$1"
  else
    echo ""
  fi
}

use_if_profile() {
  local p="$1"
  if [ -n "$p" ]; then
    hermes profile use "$p" >/dev/null
  fi
}

run_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "$p" ]; then
    shift
    use_if_profile "$p"
    echo "Hermes profile active: $p"
    echo
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  exec hermes "$@"
}

task_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "$p" ]; then
    shift
    use_if_profile "$p"
  fi

  # Native passthrough mode:
  #   hm task main -- -z "prompt"
  #   hm task main -- --ignore-rules -z "prompt"
  # Everything after -- is passed to hermes exactly.
  if [ "${1:-}" = "--" ]; then
    shift
    exec hermes "$@"
  fi

  # Friendly prompt mode:
  #   hm task main "prompt"
  #   hm task main -
  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage:" >&2
      echo "  hm task [profile] PROMPT" >&2
      echo "  hm task [profile] - < prompt.md" >&2
      echo "  hm task [profile] -- <hermes native args...>" >&2
      exit 2
    fi
    local stdin_prompt
    stdin_prompt="$(cat)"
    exec hermes -z "$stdin_prompt"
  fi

  case "$1" in
    -)
      local prompt
      prompt="$(cat)"
      exec hermes -z "$prompt"
      ;;
    -*)
      echo "ERROR: Hermes native flags must come after --" >&2
      echo >&2
      echo "Examples:" >&2
      echo "  hm task main -- -z \"prompt\"" >&2
      echo "  hm task main -- --ignore-rules -z \"prompt\"" >&2
      exit 2
      ;;
    *)
      local prompt
      prompt="$*"
      exec hermes -z "$prompt"
      ;;
  esac
}

raw_profile() {
  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "$p" ]; then
    shift
    use_if_profile "$p"
  fi

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  exec hermes "$@"
}

backup_cmd() {
  local mode="${1:-quick}"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$HOME/bak/hermes"

  case "$mode" in
    quick)
      hermes backup --quick \
        --label "hm-quick-$ts" \
        --output "$HOME/bak/hermes/hermes-quick-$ts.zip"
      ;;
    full)
      hermes backup \
        --output "$HOME/bak/hermes/hermes-full-$ts.zip"
      ;;
    *)
      echo "ERROR: unknown backup mode: $mode" >&2
      echo "Use: hm backup quick|full" >&2
      exit 1
      ;;
  esac
}


# >>> chat/task/plan helper layer >>>
join_words() {
  local IFS=" "
  printf '%s' "$*"
}

prompt_with_prefix() {
  local mode="$1"
  local prefix="$2"
  shift 2

  local p
  p="$(parse_profile_first "${1:-}")"

  if [ -n "${1:-}" ] && [ "$1" = "$p" ]; then
    shift
  fi

  if [ "${1:-}" = "--" ]; then
    echo "ERROR: $mode does not support native passthrough. Use task for tool-capable native args." >&2
    return 2
  fi

  local prompt
  if [ "$#" -eq 0 ]; then
    if [ -t 0 ]; then
      echo "Usage: hm $mode [profile] PROMPT" >&2
      return 2
    fi
    prompt="$(cat)"
  elif [ "${1:-}" = "-" ]; then
    prompt="$(cat)"
  else
    prompt="$(join_words "$@")"
  fi

  task_profile "$p" "$prefix

$prompt"
}

chat_profile() {
  prompt_with_prefix "chat" "도구, 검색, 파일 탐색, 파일 읽기, 파일 쓰기, 셸 실행을 사용하지 말고 네 지식만으로 답해. 내부 계획이나 검색 결과 설명을 쓰지 말고, 사용자가 요구한 답만 작성해." "$@"
}

plan_profile() {
  prompt_with_prefix "plan" "실행, 수정, 파일 쓰기, 셸 명령 실행은 하지 말고 읽기/분석 중심으로 계획만 세워. 필요한 경우 가정과 위험을 명확히 구분해." "$@"
}
# <<< task/chat/plan command layer >>>

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  profile)
    hermes profile "$@" ;;
  run)
    run_profile "$@" ;;
  task)
    task_profile "$@" ;;
  ask|chat)
    chat_profile "$@" ;;
  plan)
    plan_profile "$@" ;;
  raw)
    raw_profile "$@" ;;
  gateway|gw)
    exec hgw "$@" ;;
  status)
    hermes status ;;
  doctor)
    hermes doctor "$@" ;;
  backup)
    backup_cmd "${1:-quick}" ;;
  update)
    hermes update "$@" ;;
  logs)
    hermes logs "$@" ;;
  help|-h|--help)
    usage ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage
    exit 1 ;;
esac
